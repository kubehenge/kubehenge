# eth0 and lo belong to the container runtime. vmbr0 is the VMs' bridge, without DHCP: NAT through
# eth0, and the host reaches the VMs through the container's address (test/e2e/ci/up.sh).

iface eth0 inet manual

auto vmbr0
iface vmbr0 inet static
	address 172.20.99.1/24
	bridge-ports none
	bridge-stp off
	bridge-fd 0
	post-up sysctl -qw net.ipv4.ip_forward=1
	post-up iptables -t nat -C POSTROUTING -s 172.20.99.0/24 -o eth0 -j MASQUERADE 2>/dev/null || iptables -t nat -A POSTROUTING -s 172.20.99.0/24 -o eth0 -j MASQUERADE

source /etc/network/interfaces.d/*
