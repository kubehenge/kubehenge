    "workerMachine": { "cores": 4, "memoryMiB": 16384, "diskGiB": 80 },
    "upgrades": {
      "mode": "patch",
      "nodeImages": true,
      "window": { "weekdays": ["Sat"], "start": "02:00", "durationMinutes": 240, "timeZone": "Europe/London" }
    }
  },
  "nodeOS": { "family": "almalinux", "release": "10" },
  "addOns": {
    "headlamp": {
      "chart": "headlamp",
      "namespace": "headlamp",
      "version": "0.40.1",
      "value": { "enabled": true, "access": "token" }
    },
    "monitoring": {
      "chart": "kube-prometheus-stack",
      "namespace": "monitoring",
      "version": "84.3.0",
      "value": { "enabled": true }
    },
    "logs": {
      "chart": "victoria-logs-single",
      "namespace": "logs",
      "version": "0.11.12",
      "value": { "enabled": true, "collector": "node", "retentionDays": 14, "sizeGiB": 20 }
    },
    "backups": {
      "chart": "velero",
      "namespace": "velero",
      "version": "12.0.0",
      "value": {
        "enabled": true,
        "target": "offsite",
        "schedule": "0 3 * * *",
        "timeZone": "Europe/London",
        "retentionDays": 7,
        "volumes": "annotated"
      }
    }
  },
  "backupTargets": [{ "name": "offsite", "endpoint": "https://objects.example.net", "bucket": "cluster-backups" }],
