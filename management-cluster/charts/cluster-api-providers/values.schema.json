{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["namespaces", "providers", "secrets", "image", "waitTimeoutSeconds"],
  "properties": {
    "chartDigest": {
      "description": "Digest of the chart's files, which the management cluster's module passes so that a changed chart upgrades the release whatever its version says.",
      "type": "string"
    },
    "namespaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/name" },
      "uniqueItems": true
    },
    "providers": {
      "description": "Cluster API Operator provider objects; their spec is the operator's, which its CRDs check.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "name", "namespace", "spec", "manifests"],
        "properties": {
          "kind": {
            "enum": ["CoreProvider", "BootstrapProvider", "ControlPlaneProvider", "InfrastructureProvider", "IPAMProvider", "AddonProvider"]
          },
          "name": { "$ref": "#/$defs/name" },
          "namespace": { "$ref": "#/$defs/name" },
          "spec": {
            "type": "object",
            "required": ["version", "fetchConfig"],
            "properties": { "version": { "type": "string" } }
          },
          "manifests": {
            "description": "The files the operator installs the provider from, which the release's hook downloads and checks for it.",
            "type": "object",
            "additionalProperties": false,
            "required": ["metadata", "components"],
            "properties": {
              "metadata": { "$ref": "#/$defs/file" },
              "components": { "$ref": "#/$defs/file" }
            }
          }
        }
      }
    },
    "secrets": {
      "description": "Secrets by name, each with its namespace and string data.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["namespace", "data"],
        "properties": {
          "namespace": { "$ref": "#/$defs/name" },
          "data": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      }
    },
    "image": {
      "description": "Kubehenge's controller image by digest, whose `kubehenge manifests` and `kubehenge wait` the release's hooks run.",
      "type": "string",
      "pattern": "^[^@]+@sha256:[0-9a-f]{64}$"
    },
    "waitTimeoutSeconds": {
      "type": "integer",
      "minimum": 60
    }
  },
  "$defs": {
    "file": {
      "description": "A file by its address and SHA-256.",
      "type": "string",
      "pattern": "^https://[^@\\s]+@sha256:[0-9a-f]{64}$"
    },
    "name": {
      "description": "A Kubernetes object or namespace name.",
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
      "maxLength": 253
    }
  }
}
