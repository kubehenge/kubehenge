root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[{*.go,go.mod,Makefile}]
indent_style = tab

# shfmt reads these.
[*.sh]
indent_size = 4
switch_case_indent = true
space_redirects = true

# The kernel's ifupdown file format.
[test/e2e/pve/interfaces]
indent_style = tab

[*.md]
# Two trailing spaces are a line break.
trim_trailing_whitespace = false
