{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["workloadPool", "providerNamespaces", "interface", "clusters", "clusterOIDC", "backupTargets", "podSecurityExempt", "image", "kubeVip", "talos", "etcdProxy", "proxmox", "addons", "autoscaler"],
  "properties": {
    "chartDigest": {
      "description": "Digest of the chart's files, which the management cluster's module passes so that a changed chart upgrades the release whatever its version says.",
      "type": "string"
    },
    "workloadPool": {
      "description": "Proxmox VE pool the management cluster's Cluster API token manages, nested at most one level.",
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)?$"
    },
    "providerNamespaces": {
      "description": "Namespaces of the Cluster API providers only one ClusterClass's clusters use, by class.",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/$defs/name" },
        "uniqueItems": true
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace"],
      "properties": {
        "namespace": { "$ref": "#/$defs/name" },
        "extraNamespaces": {
          "description": "More namespaces the interface creates and manages clusters in, none of Kubernetes', the providers' or Kubehenge's own.",
          "type": "array",
          "items": { "$ref": "#/$defs/name" },
          "uniqueItems": true
        },
        "offerHARules": {
          "description": "Whether those who may create or change a cluster are offered Proxmox VE's HA node-affinity rules, their names and nodes only, without Sys.Audit on / of their own.",
          "type": "boolean"
        },
        "headlampSignIn": {
          "description": "Whether the shared Headlamp signs those who may download a cluster's admin kubeconfig in as cluster-admin.",
          "type": "boolean"
        },
        "headlampActions": {
          "description": "Whether the shared Headlamp offers its Helm app catalog and Prometheus charts, acting with each user's own credentials in the cluster.",
          "type": "boolean"
        }
      }
    },
    "clusters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storages", "bridges"],
      "properties": {
        "storages": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "bridges": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "clusterOIDC": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issuerURL", "clientID"],
        "properties": {
          "issuerURL": { "type": "string", "pattern": "^https://", "maxLength": 2048 },
          "clientID": { "type": "string", "minLength": 1, "maxLength": 256 },
          "usernameClaim": { "type": "string", "minLength": 1 },
          "usernamePrefix": { "$ref": "#/$defs/oidcPrefix" },
          "groupsClaim": { "type": "string", "minLength": 1 },
          "groupsPrefix": { "$ref": "#/$defs/oidcPrefix" },
          "scopes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "certificateAuthority": { "type": "string", "pattern": "-----BEGIN CERTIFICATE-----" }
        }
      }
    },
    "backupTargets": {
      "description": "S3 stores clusters back up to, each cluster under a prefix of its own.",
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "bucket"],
        "properties": {
          "name": { "$ref": "#/$defs/name" },
          "endpoint": { "type": "string", "pattern": "^https://[^/?#@]+(/[^?#]*)?$", "maxLength": 2048 },
          "bucket": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$" },
          "region": { "type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 64 },
          "prefix": { "type": "string", "pattern": "^[A-Za-z0-9!_.*'()-]+(/[A-Za-z0-9!_.*'()-]+)*$", "maxLength": 256 },
          "caCertificate": { "type": "string", "pattern": "-----BEGIN CERTIFICATE-----" },
          "checksums": { "type": "boolean" }
        }
      }
    },
    "podSecurityExempt": {
      "description": "Namespaces neither Pod Security Admission nor Kyverno holds to a cluster's pod security level.",
      "type": "array",
      "items": { "$ref": "#/$defs/name" },
      "uniqueItems": true
    },
    "image": {
      "description": "Kubehenge's controller image by digest, which a release's chart names and a checkout's needs given.",
      "type": "string",
      "pattern": "^([^@]+@sha256:[0-9a-f]{64})?$"
    },
    "kubeVip": {
      "description": "kube-vip's image by registry, repository, tag and digest.",
      "$ref": "#/$defs/pinnedImage"
    },
    "talos": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imageSignatures"],
      "properties": {
        "imageSignatures": {
          "description": "Talos ImageVerificationConfig rules: the images Talos nodes pull only with a matching keyless signature.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["image", "keyless"],
            "properties": {
              "image": { "type": "string", "minLength": 1 },
              "keyless": {
                "type": "object",
                "additionalProperties": false,
                "required": ["issuer"],
                "oneOf": [{ "required": ["subject"] }, { "required": ["subjectRegex"] }],
                "properties": {
                  "issuer": { "type": "string", "minLength": 1 },
                  "subject": { "type": "string", "minLength": 1 },
                  "subjectRegex": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    "managementEndpoint": {
      "description": "The management cluster's API as workload clusters reach it, for autoscalers that run inside their cluster; empty, none can.",
      "type": "string",
      "pattern": "^(https://[^\\s/]+)?$"
    },
    "watch": {
      "description": "What the controller watches for on its own, and how long it gives each before it reports it.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stallMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 }
      }
    },
    "autoscaler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "images"],
      "properties": {
        "namespace": { "$ref": "#/$defs/name" },
        "images": {
          "description": "The cluster autoscaler's images, one for each Kubernetes minor version, by registry, repository, tag and digest.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[^\\s:@]+(:[0-9]+)?/[^\\s:@]+:v1\\.[0-9]+\\.[0-9]+@sha256:[0-9a-f]{64}$"
          },
          "uniqueItems": true
        }
      }
    },
    "etcdProxy": {
      "description": "The image of the etcd proxy on k3s control planes, by registry, repository, tag and digest.",
      "$ref": "#/$defs/pinnedImage"
    },
    "proxmox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "insecure", "secret", "clusterGroup", "clusterRole", "volumeOwnerNode", "region", "ha", "datastoreAllocate", "sysAuditGroup", "volumeSnapshots", "etcdRestore"],
      "properties": {
        "url": { "type": "string", "pattern": "^https://[^/]+" },
        "insecure": { "type": "boolean" },
        "secret": { "$ref": "#/$defs/name" },
        "clusterGroup": { "type": "string", "minLength": 1 },
        "clusterRole": { "type": "string", "minLength": 1 },
        "volumeOwnerNode": { "type": "string" },
        "region": { "type": "string" },
        "ha": { "type": "boolean" },
        "datastoreAllocate": {
          "description": "The role that gives a cluster Datastore.Allocate on its storage, empty when no cluster may choose it, and the storages the management cluster uses.",
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "managementStorages"],
          "properties": {
            "role": { "type": "string" },
            "managementStorages": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]*$" }, "uniqueItems": true }
          }
        },
        "sysAuditGroup": {
          "description": "The group holding Sys.Audit on / that clusters asking for the cloud controller manager's HA group labels join, empty when no cluster may.",
          "type": "string"
        },
        "volumeSnapshots": {
          "description": "The Secret holding root@pam's password for the CSI plugin of clusters that take volume snapshots, empty when no cluster may.",
          "type": "object",
          "additionalProperties": false,
          "required": ["rootSecret"],
          "properties": {
            "rootSecret": { "anyOf": [{ "const": "" }, { "$ref": "#/$defs/name" }] }
          }
        },
        "etcdRestore": { "type": "boolean" }
      }
    },
    "templateRefresh": {
      "description": "The weekly build of the node OS VM templates, and the builds asked for in the interface.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "weekday": { "enum": ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"] },
        "time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "timeZone": { "type": "string", "minLength": 1 },
        "soakHours": { "type": "integer", "minimum": 0, "maximum": 720 },
        "secret": { "$ref": "#/$defs/name" },
        "node": { "type": "string" },
        "storage": { "type": "string" },
        "importStorage": { "type": "string" },
        "isoStorage": { "type": "string" },
        "pool": { "type": "string", "minLength": 1 },
        "bridge": { "type": "string", "minLength": 1 },
        "vlan": { "type": "integer", "minimum": 0, "maximum": 4094 },
        "address": { "type": "string", "pattern": "^([0-9.]+/[0-9]+)?$" },
        "gateway": { "type": "string" },
        "dns": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "creatorBuilds": { "type": "boolean" }
      },
      "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
      "then": {
        "properties": {
          "node": { "minLength": 1 },
          "storage": { "minLength": 1 },
          "importStorage": { "minLength": 1 }
        }
      }
    },
    "addons": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headlamp", "rancher", "monitoring", "loki", "alloy", "velero", "kyverno", "kyvernoPolicies", "istio", "istioBase", "istioCNI", "istioZtunnel", "certManager", "cloudControllerManager", "csiPlugin", "csiPluginNewest", "snapshotController", "cilium", "calico", "traefik", "metallb", "kubeVip", "kubeVipCloudProvider", "argocd", "fluxOperator"],
      "properties": {
        "headlamp": { "$ref": "#/$defs/chartOnly" },
        "rancher": {
          "allOf": [{ "$ref": "#/$defs/chart" }],
          "required": ["kubernetes", "turtles"],
          "properties": {
            "kubernetes": {
              "description": "Kubernetes minor versions the Rancher release runs on, as <min>-<max>.",
              "type": "string",
              "pattern": "^[0-9]+-[0-9]+$"
            },
            "turtles": {
              "description": "The images of the Turtles release Rancher installs and of the Cluster API controller it runs.",
              "type": "object",
              "required": ["image", "clusterAPI"],
              "properties": {
                "image": { "$ref": "#/$defs/pinnedImage" },
                "clusterAPI": { "$ref": "#/$defs/pinnedImage" }
              },
              "additionalProperties": false
            }
          },
          "unevaluatedProperties": false
        },
        "monitoring": {
          "allOf": [{ "$ref": "#/$defs/chart" }],
          "required": ["kubeRBACProxy"],
          "properties": {
            "kubeRBACProxy": {
              "description": "kube-rbac-proxy's image by registry, repository, tag and digest.",
              "$ref": "#/$defs/pinnedImage"
            }
          },
          "unevaluatedProperties": false
        },
        "loki": { "$ref": "#/$defs/chartOnly" },
        "alloy": {
          "allOf": [{ "$ref": "#/$defs/chart" }],
          "required": ["image"],
          "properties": {
            "image": {
              "description": "Grafana Alloy's image by registry, repository, tag and digest.",
              "$ref": "#/$defs/pinnedImage"
            }
          },
          "unevaluatedProperties": false
        },
        "velero": {
          "allOf": [{ "$ref": "#/$defs/chart" }],
          "required": ["image", "plugin"],
          "properties": {
            "image": {
              "description": "Velero's image by registry, repository, tag and digest, for its server, its node agents and the restores of volumes.",
              "$ref": "#/$defs/pinnedImage"
            },
            "plugin": {
              "description": "The image of Velero's plugin for S3 by registry, repository, tag and digest.",
              "$ref": "#/$defs/pinnedImage"
            }
          },
          "unevaluatedProperties": false
        },
        "kyverno": { "$ref": "#/$defs/chartOnly" },
        "kyvernoPolicies": { "$ref": "#/$defs/chartOnly" },
        "istio": { "$ref": "#/$defs/chartOnly" },
        "istioBase": { "$ref": "#/$defs/chartOnly" },
        "istioCNI": { "$ref": "#/$defs/chartOnly" },
        "istioZtunnel": { "$ref": "#/$defs/chartOnly" },
        "certManager": { "$ref": "#/$defs/chartOnly" },
        "cloudControllerManager": { "$ref": "#/$defs/chartOnly" },
        "csiPlugin": { "$ref": "#/$defs/chartOnly" },
        "csiPluginNewest": { "$ref": "#/$defs/chartOnly" },
        "snapshotController": { "$ref": "#/$defs/chartOnly" },
        "cilium": { "$ref": "#/$defs/chartOnly" },
        "calico": {
          "allOf": [{ "$ref": "#/$defs/chart" }],
          "required": ["images"],
          "properties": {
            "images": {
              "description": "The images the Tigera operator runs Calico from, by registry, repository, tag and digest, all at one release.",
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/pinnedImage" },
              "uniqueItems": true
            }
          },
          "unevaluatedProperties": false
        },
        "traefik": { "$ref": "#/$defs/chartOnly" },
        "metallb": { "$ref": "#/$defs/chartOnly" },
        "kubeVip": { "$ref": "#/$defs/chartOnly" },
        "kubeVipCloudProvider": { "$ref": "#/$defs/chartOnly" },
        "argocd": { "$ref": "#/$defs/chartOnly" },
        "fluxOperator": {
          "allOf": [{ "$ref": "#/$defs/chart" }],
          "required": ["flux"],
          "properties": {
            "flux": {
              "description": "The Flux release the operator installs from the manifests inside its image.",
              "type": "string",
              "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"
            }
          },
          "unevaluatedProperties": false
        }
      }
    }
  },
  "$defs": {
    "name": {
      "description": "A Kubernetes object or namespace name.",
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "maxLength": 63
    },
    "oidcPrefix": {
      "type": "string",
      "maxLength": 64,
      "not": { "pattern": "^system:" }
    },
    "chart": {
      "type": "object",
      "required": ["repository", "chart", "version"],
      "properties": {
        "repository": { "type": "string", "pattern": "^(https|oci)://" },
        "chart": { "type": "string", "minLength": 1 },
        "version": {
          "description": "The chart's version and the digest it is pulled by, as <version>@sha256:<digest>.",
          "type": "string",
          "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+[^@]*@sha256:[0-9a-f]{64}$"
        },
        "values": {
          "description": "Values beneath those Kubehenge gives the chart: the images it runs, each by tag and digest.",
          "type": "object"
        }
      }
    },
    "chartOnly": {
      "allOf": [{ "$ref": "#/$defs/chart" }],
      "unevaluatedProperties": false
    },
    "pinnedImage": {
      "type": "string",
      "pattern": "^[^/@]+/[^:@]+:[^@]+@sha256:[0-9a-f]{64}$"
    }
  }
}
