diff --git a/pkg/csi/protection.go b/pkg/csi/protection.go
new file mode 100644
index 0000000..e28e35c
--- /dev/null
+++ b/pkg/csi/protection.go
@@ -0,0 +1,257 @@
+/*
+Copyright 2023 The Kubernetes Authors.
+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+    http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package csi
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+	"sync"
+	"time"
+
+	proxmox "github.com/luthermonson/go-proxmox"
+
+	goproxmox "github.com/sergelogvinov/go-proxmox"
+
+	"k8s.io/klog/v2"
+)
+
+// liftedMarker ends the description of a VM whose protection a detach has lifted. It goes on in
+// the same change that lifts the protection and comes off in the one that sets it again, so a VM
+// that carries it is one this plugin left unprotected, as a controller stopped mid-detach does.
+// KeepProtection protects every such VM again.
+const liftedMarker = "proxmox-csi-plugin lifted this VM's protection to detach a volume and sets it again."
+
+const (
+	// protectAgainAttempts bounds setting protection again after a detach.
+	protectAgainAttempts = 5
+	// protectAgainTimeout bounds those attempts, which run on after the request's context ends.
+	protectAgainTimeout = 2 * time.Minute
+	// keepProtectionEvery is how often KeepProtection looks for marked VMs.
+	keepProtectionEvery = time.Minute
+)
+
+// protectAgainWait is the pause between those attempts, a variable for the tests.
+var protectAgainWait = 3 * time.Second
+
+type liftedVM struct {
+	cl *goproxmox.APIClient
+	id int
+}
+
+// liftedVMs holds the VMs a detach in this process has lifted the protection of and not yet set it
+// again on, which KeepProtection passes by.
+type liftedVMs struct {
+	mu  sync.Mutex
+	vms map[liftedVM]struct{}
+}
+
+func (l *liftedVMs) add(vm liftedVM) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+
+	if l.vms == nil {
+		l.vms = map[liftedVM]struct{}{}
+	}
+
+	l.vms[vm] = struct{}{}
+}
+
+func (l *liftedVMs) remove(vm liftedVM) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+
+	delete(l.vms, vm)
+}
+
+// withoutProtection lifts the protection of vm, runs do and sets the protection again on every
+// path, a failed lift included, since the lift may have taken effect without its answer arriving.
+func (l *liftedVMs) withoutProtection(ctx context.Context, cl *goproxmox.APIClient, vm *proxmox.VirtualMachine, do func() error) error {
+	id := liftedVM{cl: cl, id: int(vm.VMID)}
+	l.add(id)
+	defer l.remove(id)
+	defer protectAgain(ctx, cl, id.id)
+
+	klog.InfoS("Lifting the VM's protection to detach a volume", "vmID", id.id)
+
+	task, err := vm.Config(ctx,
+		proxmox.VirtualMachineOption{Name: "protection", Value: 0},
+		proxmox.VirtualMachineOption{Name: "description", Value: withMarker(vm.VirtualMachineConfig.Description)},
+		proxmox.VirtualMachineOption{Name: "digest", Value: vm.VirtualMachineConfig.Digest},
+	)
+	if err == nil {
+		err = waitConfigTask(ctx, task, "unable to lift the VM's protection")
+	}
+
+	if err != nil {
+		return fmt.Errorf("unable to lift the protection of VM %d to detach the disk: %w", id.id, err)
+	}
+
+	return do()
+}
+
+// protectAgain sets the protection of VM id again, retrying, and logs an error when it stays off.
+func protectAgain(ctx context.Context, cl *goproxmox.APIClient, id int) {
+	ctx, cancel := context.WithTimeout(context.WithoutCancel(ctx), protectAgainTimeout)
+	defer cancel()
+
+	var err error
+
+	for attempt := 1; attempt <= protectAgainAttempts; attempt++ {
+		if _, err = restoreProtection(ctx, cl, id); err == nil {
+			return
+		}
+
+		klog.ErrorS(err, "Failed to set the VM's protection again, retrying", "vmID", id, "attempt", attempt)
+
+		if attempt < protectAgainAttempts {
+			select {
+			case <-ctx.Done():
+				attempt = protectAgainAttempts
+			case <-time.After(protectAgainWait):
+			}
+		}
+	}
+
+	klog.ErrorS(err, "VM IS LEFT WITHOUT PROTECTION: the plugin sets it again within a minute, or run qm set <vmID> --protection 1",
+		"vmID", id)
+}
+
+// restoreProtection sets the protection of VM id again and takes the marker off, if it carries
+// the marker. It reports whether it did. A VM that is gone, or unprotected without the marker, is
+// left as it is.
+func restoreProtection(ctx context.Context, cl *goproxmox.APIClient, id int) (bool, error) {
+	vm, err := cl.GetVMConfig(ctx, id)
+	if err != nil {
+		if errors.Is(err, goproxmox.ErrVirtualMachineNotFound) {
+			return false, nil
+		}
+
+		return false, fmt.Errorf("failed to get vm config: %w", err)
+	}
+
+	description, marked := withoutMarker(vm.VirtualMachineConfig.Description)
+	if !marked {
+		return false, nil
+	}
+
+	options := []proxmox.VirtualMachineOption{
+		{Name: "protection", Value: 1},
+		{Name: "digest", Value: vm.VirtualMachineConfig.Digest},
+	}
+	if description == "" {
+		options = append(options, proxmox.VirtualMachineOption{Name: "delete", Value: "description"})
+	} else {
+		options = append(options, proxmox.VirtualMachineOption{Name: "description", Value: description})
+	}
+
+	task, err := vm.Config(ctx, options...)
+	if err == nil {
+		err = waitConfigTask(ctx, task, "unable to set the VM's protection")
+	}
+
+	if err != nil {
+		return false, fmt.Errorf("unable to set the protection of VM %d again: %w", id, err)
+	}
+
+	return true, nil
+}
+
+func withMarker(description string) string {
+	if description == "" {
+		return liftedMarker
+	}
+
+	return description + "\n" + liftedMarker
+}
+
+func withoutMarker(description string) (string, bool) {
+	if !strings.Contains(description, liftedMarker) {
+		return description, false
+	}
+
+	description = strings.ReplaceAll(description, "\n"+liftedMarker, "")
+
+	return strings.ReplaceAll(description, liftedMarker, ""), true
+}
+
+// protectMarked sets protection again on every VM of cl that carries the marker, except those a
+// detach is working on now.
+func (l *liftedVMs) protectMarked(ctx context.Context, cl *goproxmox.APIClient) error {
+	vms, err := cl.GetVMsByFilter(ctx)
+	if err != nil {
+		if errors.Is(err, goproxmox.ErrVirtualMachineNotFound) {
+			return nil
+		}
+
+		return fmt.Errorf("failed to list VMs: %w", err)
+	}
+
+	var errs []error
+
+	for _, r := range vms {
+		if err := l.protectUnlessLifted(ctx, liftedVM{cl: cl, id: int(r.VMID)}); err != nil {
+			errs = append(errs, err)
+		}
+	}
+
+	return errors.Join(errs...)
+}
+
+// protectUnlessLifted holds the lock throughout, so no detach lifts the VM's protection meanwhile.
+func (l *liftedVMs) protectUnlessLifted(ctx context.Context, vm liftedVM) error {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+
+	if _, ok := l.vms[vm]; ok {
+		return nil
+	}
+
+	restored, err := restoreProtection(ctx, vm.cl, vm.id)
+	if restored {
+		klog.InfoS("Set protection again on a VM a detach had left unprotected", "vmID", vm.id)
+	}
+
+	return err
+}
+
+// KeepProtection sets protection again on every VM a detach left unprotected, as one cut off
+// between lifting and setting it does, at once and then every minute until ctx ends.
+func (d *ControllerService) KeepProtection(ctx context.Context) {
+	t := time.NewTicker(keepProtectionEvery)
+	defer t.Stop()
+
+	for {
+		for _, region := range d.pxpool.GetRegions() {
+			cl, err := d.pxpool.GetProxmoxCluster(region)
+			if err == nil {
+				err = d.lifted.protectMarked(ctx, cl)
+			}
+
+			if err != nil {
+				klog.ErrorS(err, "Failed to set protection again on VMs a detach left unprotected", "region", region)
+			}
+		}
+
+		select {
+		case <-ctx.Done():
+			return
+		case <-t.C:
+		}
+	}
+}
diff --git a/pkg/csi/protection_test.go b/pkg/csi/protection_test.go
new file mode 100644
index 0000000..f180834
--- /dev/null
+++ b/pkg/csi/protection_test.go
@@ -0,0 +1,309 @@
+/*
+Copyright 2023 The Kubernetes Authors.
+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+    http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package csi
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strconv"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	goproxmox "github.com/sergelogvinov/go-proxmox"
+	volume "github.com/sergelogvinov/proxmox-csi-plugin/pkg/utils/volume"
+)
+
+const (
+	fakeVMID        = 100
+	fakeDisk        = "vm-9999-disk-0"
+	fakeDescription = "Node VM"
+)
+
+// fakePVE answers as Proxmox VE does for one running VM, refusing to unlink a drive while the VM
+// is protected and to change a configuration whose digest moved on.
+type fakePVE struct {
+	mu          sync.Mutex
+	protection  int
+	description string
+	scsi1       string
+	digest      int
+	calls       []string
+
+	failLift    bool
+	failUnlink  bool
+	failProtect bool
+}
+
+func (f *fakePVE) serveHTTP(w http.ResponseWriter, r *http.Request) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+
+	vm := "/api2/json/nodes/pve/qemu/" + strconv.Itoa(fakeVMID)
+	fail := func(msg string) {
+		w.WriteHeader(http.StatusInternalServerError)
+		_ = json.NewEncoder(w).Encode(map[string]any{"data": nil, "message": msg})
+	}
+	reply := func(data any) { _ = json.NewEncoder(w).Encode(map[string]any{"data": data}) }
+
+	switch {
+	case r.Method == http.MethodGet && r.URL.Path == "/api2/json/cluster/resources":
+		reply([]map[string]any{{"id": "qemu/100", "type": "qemu", "vmid": fakeVMID, "node": "pve", "name": "node-1", "status": "running"}})
+	case r.Method == http.MethodGet && r.URL.Path == vm+"/status/current":
+		reply(map[string]any{"vmid": fakeVMID, "name": "node-1", "status": "running"})
+	case r.Method == http.MethodGet && r.URL.Path == vm+"/config":
+		config := map[string]any{"digest": strconv.Itoa(f.digest), "protection": f.protection, "scsi0": "local-lvm:vm-100-disk-0"}
+		if f.description != "" {
+			config["description"] = f.description
+		}
+
+		if f.scsi1 != "" {
+			config["scsi1"] = f.scsi1
+		}
+
+		reply(config)
+	case r.Method == http.MethodPost && r.URL.Path == vm+"/config":
+		var body map[string]any
+		if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+			fail(err.Error())
+
+			return
+		}
+
+		f.calls = append(f.calls, "config protection="+toString(body["protection"]))
+
+		if body["digest"] != strconv.Itoa(f.digest) {
+			fail("detected modified configuration - file changed by other user? Try again.")
+
+			return
+		}
+
+		if (f.failLift && toString(body["protection"]) == "0") || (f.failProtect && toString(body["protection"]) == "1") {
+			fail("unable to write the configuration")
+
+			return
+		}
+
+		f.protection, _ = strconv.Atoi(toString(body["protection"]))
+		if d, ok := body["description"].(string); ok {
+			f.description = d
+		}
+
+		if body["delete"] == "description" {
+			f.description = ""
+		}
+
+		f.digest++
+
+		reply(nil)
+	case r.Method == http.MethodPut && r.URL.Path == vm+"/unlink":
+		f.calls = append(f.calls, "unlink")
+
+		if f.protection == 1 {
+			fail("can't remove drive 'scsi1' - protection mode enabled")
+
+			return
+		}
+
+		if f.failUnlink {
+			fail("unable to unlink the drive")
+
+			return
+		}
+
+		f.scsi1 = ""
+		f.digest++
+
+		reply(nil)
+	default:
+		w.WriteHeader(http.StatusNotFound)
+	}
+}
+
+func toString(v any) string {
+	switch v := v.(type) {
+	case float64:
+		return strconv.Itoa(int(v))
+	case string:
+		return v
+	default:
+		return ""
+	}
+}
+
+func newFakePVE(t *testing.T, f *fakePVE) *goproxmox.APIClient {
+	t.Helper()
+
+	srv := httptest.NewServer(http.HandlerFunc(f.serveHTTP))
+	t.Cleanup(srv.Close)
+
+	cl, err := goproxmox.NewAPIClient(srv.URL + "/api2/json")
+	require.NoError(t, err)
+
+	return cl
+}
+
+func attachedVM(protection int) *fakePVE {
+	return &fakePVE{
+		protection:  protection,
+		description: fakeDescription,
+		scsi1:       "local-lvm:" + fakeDisk + ",backup=0,wwn=0x5056432d49443031",
+	}
+}
+
+func detach(t *testing.T, cl *goproxmox.APIClient, lifted *liftedVMs) error {
+	t.Helper()
+
+	return detachVolume(context.Background(), cl, fakeVMID, volume.NewVolume("region", "pve", "local-lvm", fakeDisk), lifted)
+}
+
+func shortWait(t *testing.T) {
+	t.Helper()
+
+	wait := protectAgainWait
+	protectAgainWait = time.Millisecond
+
+	t.Cleanup(func() { protectAgainWait = wait })
+}
+
+func TestDetachProtectedVMLiftsAndSetsProtectionAgain(t *testing.T) {
+	f := attachedVM(1)
+	cl := newFakePVE(t, f)
+
+	require.NoError(t, detach(t, cl, &liftedVMs{}))
+
+	assert.Empty(t, f.scsi1)
+	assert.Equal(t, 1, f.protection)
+	assert.Equal(t, fakeDescription, f.description)
+	assert.Equal(t, []string{"config protection=0", "unlink", "config protection=1"}, f.calls)
+}
+
+func TestDetachUnprotectedVMChangesNoProtection(t *testing.T) {
+	f := attachedVM(0)
+	cl := newFakePVE(t, f)
+
+	require.NoError(t, detach(t, cl, &liftedVMs{}))
+
+	assert.Empty(t, f.scsi1)
+	assert.Equal(t, 0, f.protection)
+	assert.Equal(t, []string{"unlink"}, f.calls)
+}
+
+func TestDetachFailedSetsProtectionAgain(t *testing.T) {
+	f := attachedVM(1)
+	f.failUnlink = true
+	cl := newFakePVE(t, f)
+
+	require.ErrorContains(t, detach(t, cl, &liftedVMs{}), "failed to unlink disk")
+
+	assert.NotEmpty(t, f.scsi1)
+	assert.Equal(t, 1, f.protection)
+	assert.Equal(t, fakeDescription, f.description)
+	assert.Equal(t, []string{"config protection=0", "unlink", "config protection=1"}, f.calls)
+}
+
+func TestDetachFailedLiftUnlinksNothing(t *testing.T) {
+	f := attachedVM(1)
+	f.failLift = true
+	cl := newFakePVE(t, f)
+
+	require.ErrorContains(t, detach(t, cl, &liftedVMs{}), "unable to lift the protection of VM 100")
+
+	assert.NotEmpty(t, f.scsi1)
+	assert.Equal(t, 1, f.protection)
+	assert.NotContains(t, f.calls, "unlink")
+}
+
+func TestDetachFailedProtectAgainRetriesAndLeavesMarker(t *testing.T) {
+	shortWait(t)
+
+	f := attachedVM(1)
+	f.failProtect = true
+	cl := newFakePVE(t, f)
+	lifted := &liftedVMs{}
+
+	require.NoError(t, detach(t, cl, lifted))
+
+	assert.Empty(t, f.scsi1)
+	assert.Equal(t, 0, f.protection)
+	assert.Equal(t, fakeDescription+"\n"+liftedMarker, f.description)
+
+	protects := 0
+
+	for _, c := range f.calls {
+		if c == "config protection=1" {
+			protects++
+		}
+	}
+
+	assert.Equal(t, protectAgainAttempts, protects)
+	assert.Empty(t, lifted.vms)
+
+	f.failProtect = false
+
+	require.NoError(t, lifted.protectMarked(context.Background(), cl))
+	assert.Equal(t, 1, f.protection)
+	assert.Equal(t, fakeDescription, f.description)
+}
+
+func TestProtectMarkedProtectsMarkedVM(t *testing.T) {
+	f := &fakePVE{description: liftedMarker}
+	cl := newFakePVE(t, f)
+
+	require.NoError(t, (&liftedVMs{}).protectMarked(context.Background(), cl))
+
+	assert.Equal(t, 1, f.protection)
+	assert.Empty(t, f.description)
+}
+
+func TestProtectMarkedLeavesUnmarkedVM(t *testing.T) {
+	f := &fakePVE{description: fakeDescription}
+	cl := newFakePVE(t, f)
+
+	require.NoError(t, (&liftedVMs{}).protectMarked(context.Background(), cl))
+
+	assert.Equal(t, 0, f.protection)
+	assert.Empty(t, f.calls)
+}
+
+func TestProtectMarkedPassesByVMBeingDetached(t *testing.T) {
+	f := &fakePVE{description: fakeDescription + "\n" + liftedMarker}
+	cl := newFakePVE(t, f)
+	lifted := &liftedVMs{}
+	lifted.add(liftedVM{cl: cl, id: fakeVMID})
+
+	require.NoError(t, lifted.protectMarked(context.Background(), cl))
+
+	assert.Equal(t, 0, f.protection)
+	assert.Empty(t, f.calls)
+}
+
+func TestMarkerRoundTrip(t *testing.T) {
+	for _, description := range []string{"", fakeDescription, "two\nlines"} {
+		got, marked := withoutMarker(withMarker(description))
+		assert.True(t, marked)
+		assert.Equal(t, description, got)
+	}
+
+	_, marked := withoutMarker(fakeDescription)
+	assert.False(t, marked)
+}
