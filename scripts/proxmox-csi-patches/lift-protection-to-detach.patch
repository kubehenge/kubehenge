+
+func unlinkDisk(ctx context.Context, vm *proxmox.VirtualMachine, device string) error {
+	task, err := vm.UnlinkDisk(ctx, device, false)
+	if err != nil {
+		return fmt.Errorf("failed to unlink disk: %v", err)
+	}
+
+	return waitConfigTask(ctx, task, "unable to detach virtual machine disk")
+}
+
+// waitConfigTask waits for a configuration task, which a synchronous change leaves nil.
+func waitConfigTask(ctx context.Context, task *proxmox.Task, what string) error {
+	if task == nil {
+		return nil
+	}
+
+	if err := task.WaitFor(ctx, 5*60); err != nil {
+		return fmt.Errorf("%s: %w", what, err)
+	}
+
+	if task.IsFailed {
+		return fmt.Errorf("%s: %s", what, task.ExitStatus)
 	}

 	return nil
