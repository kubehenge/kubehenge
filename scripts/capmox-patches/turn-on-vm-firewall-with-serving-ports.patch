+// validPorts tells whether text is a port or a range first:last of ports.
+func validPorts(text string) bool {
+	first, last, isRange := strings.Cut(text, ":")
+	from, fromErr := strconv.ParseUint(first, 10, 16)
+	if fromErr != nil || from == 0 {
+		return false
+	}
+	if !isRange {
+		return true
+	}
+	to, toErr := strconv.ParseUint(last, 10, 16)
+	return toErr == nil && to >= from
+}
