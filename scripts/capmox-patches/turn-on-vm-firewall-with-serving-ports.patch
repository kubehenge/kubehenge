+	}
+}
+
+// groupRules apply the security groups given.
+func groupRules(groups ...string) []*lutherproxmox.FirewallRule {
+	rules := make([]*lutherproxmox.FirewallRule, 0, len(groups))
+	for _, group := range groups {
+		rules = append(rules, &lutherproxmox.FirewallRule{Type: "group", Action: group, Enable: 1})
+	}
+	return rules
 }

