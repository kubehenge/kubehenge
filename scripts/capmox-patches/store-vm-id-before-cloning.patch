+// The spec and the status of a ProxmoxMachine are written by separate requests, and the status
+// write goes ahead when the spec write fails. A spec write after the clone that times out in the
+// admission webhook must not lead to a second clone.
+func TestEnsureVirtualMachine_SpecWriteFails_ClonesOnce(t *testing.T) {
+	machineScope, proxmoxClient, kubeClient := setupReconcilerTest(t)
+
+	cloned, webhookTimeouts := false, 1
+	intercepted := interceptor.NewClient(kubeClient.(client.WithWatch), interceptor.Funcs{
+		Patch: func(ctx context.Context, c client.WithWatch, obj client.Object, p client.Patch, opts ...client.PatchOption) error {
+			if _, ok := obj.(*infrav1.ProxmoxMachine); ok && cloned && webhookTimeouts > 0 {
+				webhookTimeouts--
+				return apierrors.NewInternalError(errors.New(`failed calling webhook "default.proxmoxmachine.infrastructure.cluster.x-k8s.io": context deadline exceeded`))
+			}
+			return c.Patch(ctx, obj, p, opts...)
+		},
+	})
+
+	proxmoxClient.EXPECT().NextVMID(mock.Anything).Return(int64(107), nil).Once()
+	proxmoxClient.EXPECT().CloneVM(mock.Anything, 123, mock.Anything).
+		Run(func(context.Context, int, proxmox.VMCloneRequest) { cloned = true }).
+		Return(cloneResponse(proxmoxClient, 107), nil).Once()
+
+	errs := reconcileRounds(t, machineScope, intercepted, 4)
+
+	require.Zero(t, webhookTimeouts, "the spec write after the clone failed")
+	require.ErrorContains(t, errs[0], "context deadline exceeded")
+	require.Equal(t, []error{nil, nil, nil}, errs[1:])
+	requireClonedVM(t, machineScope, kubeClient, 107)
+}
