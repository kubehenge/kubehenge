+
+// reconcileRounds runs the clone part of a ProxmoxMachine reconcile rounds times. Each round reads
+// the ProxmoxMachine as stored and writes back what it changed, as the controller does. It returns
+// each round's error, the write at the end included.
+func reconcileRounds(t *testing.T, machineScope *scope.MachineScope, kubeClient client.Client, rounds int) []error {
+	t.Helper()
+	ctx := context.Background()
+	errs := make([]error, rounds)
+	for i := range rounds {
+		pm := &infrav1.ProxmoxMachine{}
+		require.NoError(t, kubeClient.Get(ctx, client.ObjectKeyFromObject(machineScope.ProxmoxMachine), pm))
+		s, err := scope.NewMachineScope(scope.MachineScopeParams{
+			Client:         kubeClient,
+			Logger:         machineScope.Logger,
+			Cluster:        machineScope.Cluster,
+			Machine:        machineScope.Machine,
+			InfraCluster:   machineScope.InfraCluster,
+			ProxmoxMachine: pm,
+			IPAMHelper:     machineScope.IPAMHelper,
+		})
+		require.NoError(t, err)
+		inFlight, err := taskservice.ReconcileInFlightTask(ctx, s)
+		if err == nil && !inFlight {
+			_, err = ensureVirtualMachine(ctx, s)
+		}
+		errs[i] = errors.Join(err, s.Close())
+	}
+	return errs
+}
