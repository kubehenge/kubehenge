+// releaseVMID gives the reserved VM ID up after a failed clone request, once Proxmox VE reports
+// the ID free. A request can fail after Proxmox VE accepted it. Then the ID is taken, by this
+// clone or by another VM, and stays reserved. The next reconcile finds the VM under it by its
+// name, or releases the ID as a collision. It returns the clone's error.
+func releaseVMID(ctx context.Context, s *scope.MachineScope, cloneErr error) error {
+	vmID := s.GetVirtualMachineID()
+	if free, err := s.InfraCluster.ProxmoxClient.CheckID(ctx, vmID); err != nil || !free {
+		return cloneErr
+	}
+	forgetVMID(s)
+	if err := s.WriteVirtualMachineID(ctx, vmIDAllocatedByControllerAnnotation); err != nil {
+		return errors.Wrapf(cloneErr, "failed to release VM ID %d: %v", vmID, err)
+	}
+	return cloneErr
+}
