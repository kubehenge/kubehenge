+// reserveVMID stores the VM ID before the clone, so a failed spec write cannot lose it.
+func reserveVMID(ctx context.Context, s *scope.MachineScope, vmID int64) error {
+	err := s.PatchNow(ctx, func() {
+		s.SetVirtualMachineID(vmID)
+		s.SetAnnotation(vmIDAllocatedByControllerAnnotation, "true")
+	})
+	if err != nil {
+		forgetVMID(s)
+		return errors.Wrapf(err, "failed to store VM ID %d", vmID)
+	}
+	return nil
+}
+
+// releaseUnusedVMID drops a VM ID this controller reserved when no VM holds it, so the next
+// reconcile clones under a new one.
+func releaseUnusedVMID(ctx context.Context, s *scope.MachineScope) (bool, error) {
+	if !vmIDCollisionIsRecoverable(s) || proxmoxMachineHasVMProvisionFailedReason(s) {
+		return false, nil
+	}
+	vmID := s.GetVirtualMachineID()
+	free, err := s.InfraCluster.ProxmoxClient.CheckID(ctx, vmID)
+	if err != nil || !free {
+		return false, err
+	}
+	s.Info("no VM holds the reserved VM ID, picking a new one", "vmID", vmID)
+	forgetVMID(s)
+	conditions.Set(s.ProxmoxMachine, metav1.Condition{
+		Type:   infrav1.ProxmoxMachineVirtualMachineProvisionedCondition,
+		Status: metav1.ConditionFalse,
+		Reason: infrav1.ProxmoxMachineVirtualMachineProvisionedCloningReason,
+	})
+	return true, nil
+}
+
+// resumeAfterCloningFailed moves a machine past a failed clone attempt once a clone runs or its VM
+// is found. Each later step runs only from the reason the step before it sets.
+func resumeAfterCloningFailed(s *scope.MachineScope) {
+	if conditions.GetReason(s.ProxmoxMachine, infrav1.ProxmoxMachineVirtualMachineProvisionedCondition) !=
+		infrav1.ProxmoxMachineVirtualMachineProvisionedCloningFailedReason {
+		return
+	}
+	conditions.Set(s.ProxmoxMachine, metav1.Condition{
+		Type:   infrav1.ProxmoxMachineVirtualMachineProvisionedCondition,
+		Status: metav1.ConditionFalse,
+		Reason: infrav1.ProxmoxMachineVirtualMachineProvisionedCloningReason,
+	})
+}
+
+func forgetVMID(s *scope.MachineScope) {
+	s.ProxmoxMachine.Spec.VirtualMachineID = nil
+	delete(s.ProxmoxMachine.Annotations, vmIDAllocatedByControllerAnnotation)
+}
