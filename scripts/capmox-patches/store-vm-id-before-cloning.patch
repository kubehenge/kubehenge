+// NextVMID returns the lowest VM ID that is free on the cluster. It reserves nothing, so a clone
+// that comes later can find the ID taken.
+func (c *APIClient) NextVMID(ctx context.Context) (int64, error) {
+	cluster, err := c.Cluster(ctx)
+	if err != nil {
+		return 0, fmt.Errorf("cannot get cluster: %w", err)
+	}
+	vmID, err := cluster.NextID(ctx)
+	if err != nil {
+		return 0, fmt.Errorf("cannot get the next free vm id: %w", err)
+	}
+	return int64(vmID), nil
+}
