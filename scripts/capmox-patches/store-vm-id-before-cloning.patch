+// reserveVMID stores the VM ID in the ProxmoxMachine before the clone takes it. The clone's
+// task goes into the status, which is written apart from the spec, and also when the spec write
+// fails. Had the clone come first, a failed spec write would leave its task recorded without its
+// VM ID. The next reconcile would then clone again and leave the first VM behind.
+func reserveVMID(ctx context.Context, s *scope.MachineScope, vmID int64) error {
+	s.SetVirtualMachineID(vmID)
+	s.SetAnnotation(vmIDAllocatedByControllerAnnotation, "true")
+	if err := s.WriteVirtualMachineID(ctx, vmIDAllocatedByControllerAnnotation); err != nil {
+		forgetVMID(s)
+		return errors.Wrapf(err, "failed to store VM ID %d before cloning", vmID)
+	}
+	return nil
