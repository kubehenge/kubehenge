+	proxmoxClient.EXPECT().GetTask(mock.Anything, upid).
+		Return(&lutherproxmox.Task{UPID: lutherproxmox.UPID(upid), Type: "qmclone", IsSuccessful: true, IsCompleted: true}, nil).Maybe()
+	vm := newStoppedVM()
+	vm.VMID = 1001
