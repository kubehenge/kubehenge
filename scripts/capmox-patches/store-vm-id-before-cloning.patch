+// WriteVirtualMachineID writes spec.virtualMachineID and the annotation named by key, as they are
+// in memory, to the API server at once. A field missing in memory is removed there. The patch
+// that ends the reconcile writes the spec and the status separately, too late for a VM ID that
+// has to be stored before the clone that takes it.
+func (m *MachineScope) WriteVirtualMachineID(ctx context.Context, key string) error {
+	var vmID, annotation any
+	if m.ProxmoxMachine.Spec.VirtualMachineID != nil {
+		vmID = *m.ProxmoxMachine.Spec.VirtualMachineID
+	}
+	if value, ok := m.ProxmoxMachine.Annotations[key]; ok {
+		annotation = value
+	}
+	data, err := json.Marshal(map[string]any{
+		"metadata": map[string]any{"annotations": map[string]any{key: annotation}},
+		"spec":     map[string]any{"virtualMachineID": vmID},
+	})
+	if err != nil {
+		return errors.Wrap(err, "failed to encode the VM ID")
+	}
+	return m.client.Patch(ctx, m.ProxmoxMachine.DeepCopy(), client.RawPatch(types.MergePatchType, data))
+}
