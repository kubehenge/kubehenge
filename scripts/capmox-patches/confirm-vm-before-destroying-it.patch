+// errNotMachineVM means the machine's VM is gone: its VM ID is free, or held by a guest that is
+// provably not the machine's VM.
+var errNotMachineVM = errors.New("the vmid does not hold this machine's vm")
+
+// destroyRequestedAnnotation holds the VM ID this provider asked Proxmox VE to destroy. A VM of
+// another name under that ID later is the freed ID handed to someone else.
+const destroyRequestedAnnotation = "kubehenge.dev/vm-destroy-requested"
+
+// unidentifiedVMError means a VM of another name holds the machine's VM ID and nothing proves it is
+// not the machine's VM renamed: no provider ID is recorded and no destroy was requested.
+type unidentifiedVMError struct {
+	vmID int64
+	name string
+	want string
+}
+
+func (e *unidentifiedVMError) Error() string {
+	return fmt.Sprintf("VM %d is named %q, not %q, and the machine has no provider ID, so it is not destroyed. "+
+		"If it is the machine's VM, rename it to %q. If that VM is gone, remove the machine's finalizer.",
+		e.vmID, e.name, e.want, e.want)
+}
