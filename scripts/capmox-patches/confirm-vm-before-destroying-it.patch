+// locateMachineVM returns the node holding the machine's VM under vmID. It returns errNotMachineVM
+// when the ID is free or holds a container or another VM, and ErrVMNotInitialized while a clone
+// has not named the VM yet. Any other error means the VM could not be confirmed as the machine's,
+// and nothing may be destroyed.
+func locateMachineVM(ctx context.Context, machineScope *scope.MachineScope, vmID int64) (string, error) {
+	proxmoxClient := machineScope.InfraCluster.ProxmoxClient
+
+	free, err := proxmoxClient.CheckID(ctx, vmID)
+	if err != nil {
+		return "", err
+	}
+	if free {
+		return "", errNotMachineVM
+	}
+
+	resource, err := proxmoxClient.FindVMResource(ctx, uint64(vmID))
+	if err != nil {
+		return "", err
+	}
+	if resource.Type != "qemu" {
+		machineScope.Info("vmid holds a container, not destroying it", "vmID", vmID, "type", resource.Type)
+		return "", errNotMachineVM
+	}
+
+	// Read from the VM's configuration: the cluster's resource list takes names from status data
+	// that lags behind, and can still show the previous holder of a reused ID.
+	vm, err := proxmoxClient.GetVM(ctx, resource.Node, vmID)
+	if err != nil {
+		return "", err
+	}
+
+	name := vm.VirtualMachineConfig.Name
+	if name == "" || name == placeholderVMName(vmID) {
+		return "", ErrVMNotInitialized
+	}
+	if name != machineScope.ProxmoxMachine.GetName() {
+		machineScope.Info("vmid holds another vm, not destroying it", "vmID", vmID, "vmName", name)
+		return "", errNotMachineVM
+	}
+
+	// Names repeat across namespaces and recreated machines; the SMBIOS UUID, new with every clone
+	// and recorded as the provider ID once the clone was found, does not.
+	providerID := machineScope.ProxmoxMachine.Spec.ProviderID
+	if biosUUID := extractUUID(vm.VirtualMachineConfig.SMBios1); providerID != "" && providerID != "proxmox://"+biosUUID {
+		machineScope.Info("vmid holds another vm of the same name, not destroying it", "vmID", vmID, "providerID", providerID, "biosUUID", biosUUID)
+		return "", errNotMachineVM
+	}
+
+	return resource.Node, nil
+}
+
+// releaseMachine drops the machine from the cluster's status and removes its finalizer, for a VM
+// that is gone or was never the machine's.
+func releaseMachine(machineScope *scope.MachineScope) error {
+	machineScope.InfraCluster.ProxmoxCluster.RemoveNodeLocation(machineScope.Name(), util.IsControlPlaneMachine(machineScope.Machine))
+	ctrlutil.RemoveFinalizer(machineScope.ProxmoxMachine, infrav1.MachineFinalizer)
+	return machineScope.InfraCluster.PatchObject()
+}
+
 // VMNotFound checks if the given err is related to that the VM is not found in Proxmox.
 func VMNotFound(err error) bool {
 	return strings.Contains(err.Error(), "does not exist")
