+// stallDeletion keeps the machine and its VM, and says on the machine why. It returns no error, so
+// that the reconcile runs again after the usual wait, when the cause may be gone.
+func stallDeletion(machineScope *scope.MachineScope, reason, message string) error {
+	record.Warn(machineScope.ProxmoxMachine, reason, message)
+	conditions.Set(machineScope.ProxmoxMachine, metav1.Condition{
+		Type:    infrav1.ProxmoxMachineVirtualMachineProvisionedCondition,
+		Status:  metav1.ConditionFalse,
+		Reason:  infrav1.ProxmoxMachineVirtualMachineProvisionedDeletionFailedReason,
+		Message: message,
+	})
+	return nil
+}
+
+// locateMachineVM returns the node holding the machine's VM under vmID. It returns errNotMachineVM
+// when the ID is free or holds a container or a VM that is provably another, and an
+// unidentifiedVMError when a VM of another name might still be the machine's. It returns
+// ErrVMNotInitialized while a clone has not named the VM yet. Any other error means the VM could not
+// be confirmed as the machine's, and nothing may be destroyed.
+func locateMachineVM(ctx context.Context, machineScope *scope.MachineScope, vmID int64) (string, error) {
+	proxmoxClient := machineScope.InfraCluster.ProxmoxClient
+
+	free, err := proxmoxClient.CheckID(ctx, vmID)
+	if err != nil {
+		return "", err
+	}
+	if free {
+		return "", errNotMachineVM
+	}
+
+	resource, err := proxmoxClient.FindVMResource(ctx, uint64(vmID))
+	if err != nil {
+		return "", err
+	}
+	if resource.Type != "qemu" {
+		machineScope.Info("vmid holds a container, not destroying it", "vmID", vmID, "type", resource.Type)
+		return "", errNotMachineVM
+	}
+
+	// Read from the VM's configuration: the cluster's resource list takes names from status data
+	// that lags behind, and can still show the previous holder of a reused ID.
+	vm, err := proxmoxClient.GetVM(ctx, resource.Node, vmID)
+	if err != nil {
+		return "", err
+	}
+
+	// The SMBIOS UUID is new with every clone and recorded as the provider ID once the clone was
+	// found. Names are not: admins rename VMs, and they repeat across namespaces and recreated
+	// machines. So the UUID alone identifies the VM once it is recorded.
+	providerID := machineScope.ProxmoxMachine.Spec.ProviderID
+	if biosUUID := extractUUID(vm.VirtualMachineConfig.SMBios1); providerID != "" {
+		if providerID != "proxmox://"+biosUUID {
+			machineScope.Info("vmid holds another vm, not destroying it", "vmID", vmID, "providerID", providerID, "biosUUID", biosUUID)
+			return "", errNotMachineVM
+		}
+		return resource.Node, nil
+	}
+
+	name := vm.VirtualMachineConfig.Name
+	if name == "" || name == placeholderVMName(vmID) {
+		return "", ErrVMNotInitialized
+	}
+	machineName := machineScope.ProxmoxMachine.GetName()
+	if name == machineName {
+		return resource.Node, nil
+	}
+	if machineScope.ProxmoxMachine.Annotations[destroyRequestedAnnotation] == strconv.FormatInt(vmID, 10) {
+		machineScope.Info("vmid was freed by the destroy and holds another vm now", "vmID", vmID, "vmName", name)
+		return "", errNotMachineVM
+	}
+	return "", &unidentifiedVMError{vmID: vmID, name: name, want: machineName}
+}
+
+// releaseMachine drops the machine from the cluster's status and removes its finalizer, for a VM
+// that is gone or was never the machine's.
+func releaseMachine(machineScope *scope.MachineScope) error {
+	machineScope.InfraCluster.ProxmoxCluster.RemoveNodeLocation(machineScope.Name(), util.IsControlPlaneMachine(machineScope.Machine))
+	ctrlutil.RemoveFinalizer(machineScope.ProxmoxMachine, infrav1.MachineFinalizer)
+	return machineScope.InfraCluster.PatchObject()
+}
+
 // VMNotFound checks if the given err is related to that the VM is not found in Proxmox.
 func VMNotFound(err error) bool {
 	return strings.Contains(err.Error(), "does not exist")
