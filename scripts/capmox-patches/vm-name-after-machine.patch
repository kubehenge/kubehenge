+// A ProxmoxMachine whose template sets the prefix annotation clones its VM under its Machine's name,
+// with the prefix for the cluster's name, and is still found in the cluster's status by its own.
+func TestEnsureVirtualMachine_CreateVM_NamedAfterMachine(t *testing.T) {
+	machineScope, proxmoxClient, _ := setupReconcilerTestWithCondition(t, infrav1.ProxmoxMachineVirtualMachineProvisionedCloningReason)
+	machineScope.Machine.Name = "test-cp-x7k2p"
+	machineScope.SetAnnotation(scope.VMNamePrefixAnnotation, "kh-test")
+	expectedOptions := proxmox.VMCloneRequest{Node: "node1", Name: "kh-test-cp-x7k2p", Full: true, NewID: 123}
+	response := proxmox.VMCloneResponse{NewID: 123, Task: newTask()}
+	proxmoxClient.EXPECT().NextVMID(context.Background()).Return(int64(123), nil).Once()
+	proxmoxClient.EXPECT().CloneVM(context.Background(), 123, expectedOptions).Return(response, nil).Once()
+
+	requeue, err := ensureVirtualMachine(context.Background(), machineScope)
+	require.NoError(t, err)
+	require.True(t, requeue)
+	require.True(t, machineScope.InfraCluster.ProxmoxCluster.HasMachine(machineScope.Name(), false))
+}
+
+func TestMachineScope_VMName(t *testing.T) {
+	tests := []struct {
+		name, machine, want string
+		prefix              *string
+	}{
+		{name: "without the annotation, the ProxmoxMachine's", machine: "test-cp-x7k2p", want: "test"},
+		{name: "the cluster's name as prefix, the Machine's", machine: "test-cp-x7k2p", prefix: new("test"), want: "test-cp-x7k2p"},
+		{name: "another prefix in place of the cluster's name", machine: "test-cp-x7k2p", prefix: new("kh-test"), want: "kh-test-cp-x7k2p"},
+		{name: "a Machine named otherwise, its name", machine: "other-x7k2p", prefix: new("kh-test"), want: "other-x7k2p"},
+		{name: "a prefix too long for a host name, the Machine's", machine: "test-cp-x7k2p", prefix: new(strings.Repeat("a", 60)), want: "test-cp-x7k2p"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			machineScope, _, _ := setupReconcilerTest(t)
+			machineScope.Machine.Name = tt.machine
+			if tt.prefix != nil {
+				machineScope.SetAnnotation(scope.VMNamePrefixAnnotation, *tt.prefix)
+			}
+			require.Equal(t, tt.want, machineScope.VMName())
+		})
+	}
+}
