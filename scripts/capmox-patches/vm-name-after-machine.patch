 	"github.com/luthermonson/go-proxmox"
@@ -119,6 +120,33 @@ func (m *MachineScope) Name() string {
 	return m.ProxmoxMachine.Name
 }
 
+// VMNamePrefixAnnotation on a ProxmoxMachine, from its template, names its VM and its host after
+// its Machine, with this prefix in place of the cluster's name at the start.
+const VMNamePrefixAnnotation = "kubehenge.dev/vm-name-prefix"
+
+// maxVMName keeps a VM's name a host name, a single DNS label.
+const maxVMName = 63
+
+// VMName is the name of the machine's VM and its host. A ProxmoxMachine whose template sets
+// VMNamePrefixAnnotation takes its Machine's name, as some control-plane providers name the
+// ProxmoxMachine after its template and the Machine after the control plane. The cluster's name at
+// its start gives way to the prefix. Any other ProxmoxMachine keeps its own name, which a VM made
+// before has.
+func (m *MachineScope) VMName() string {
+	prefix, ok := m.ProxmoxMachine.Annotations[VMNamePrefixAnnotation]
+	if !ok || m.Machine == nil || m.Machine.Name == "" {
+		return m.ProxmoxMachine.Name
+	}
+	name := m.Machine.Name
+	if m.Cluster == nil || prefix == "" {
+		return name
+	}
+	if rest, found := strings.CutPrefix(name, m.Cluster.Name+"-"); found && len(prefix)+1+len(rest) <= maxVMName {
+		return prefix + "-" + rest
+	}
+	return name
+}
