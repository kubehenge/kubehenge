index 476383e..79da967 100644
--- a/internal/service/vmservice/delete_test.go
+++ b/internal/service/vmservice/delete_test.go
@@ -215,3 +215,25 @@ func TestDeleteVM_UnreadableVM(t *testing.T) {
 	require.Error(t, DeleteVM(context.TODO(), machineScope))
 	requireKept(t, machineScope)
 }
+
+// Protection is the administrator's lock: the VM is neither stopped nor destroyed, and the machine
+// names the flag and the command that clears it.
+func TestDeleteVM_ProtectedVMStallsTheDeletion(t *testing.T) {
+	machineScope, proxmoxClient := setupDeleteTest(t)
+	machineScope.ProxmoxMachine.Spec.ProviderID = "proxmox://" + testBIOSUUID
+	proxmoxClient.EXPECT().CheckID(context.TODO(), int64(123)).Return(false, nil).Once()
+	proxmoxClient.EXPECT().FindVMResource(context.TODO(), uint64(123)).Return(&proxmox.ClusterResource{VMID: 123, Node: "node1", Type: "qemu"}, nil).Once()
+	proxmoxClient.EXPECT().GetVM(context.TODO(), "node1", int64(123)).Return(&proxmox.VirtualMachine{
+		VirtualMachineConfig: &proxmox.VirtualMachineConfig{Name: "test", SMBios1: "uuid=" + testBIOSUUID, Protection: true},
+		Node:                 "node1",
+		VMID:                 123,
+	}, nil).Once()
+
+	require.NoError(t, DeleteVM(context.TODO(), machineScope))
+	requireKept(t, machineScope)
+	require.NotContains(t, machineScope.ProxmoxMachine.Annotations, destroyRequestedAnnotation)
+	cond := conditions.Get(machineScope.ProxmoxMachine, infrav1.ProxmoxMachineVirtualMachineProvisionedCondition)
+	require.NotNil(t, cond)
+	require.Contains(t, cond.Message, "protection flag")
+	require.Contains(t, cond.Message, "qm set 123 --protection 0")
+}
