 func cleanup(objs ...client.Object) {
 	Expect(testEnv.Cleanup(testEnv.GetContext(), objs...)).To(Succeed())
 }
+
+// A ProxmoxCluster marked for deletion before its Cluster, as `kubectl delete namespace` does, is
+// not reconciled again by the Cluster watch, which never passes a Cluster that gains a deletion
+// timestamp. Only the requeue brings it back.
+func TestReconcileDeleteRequeuesWhileOwningClusterIsNotDeleted(t *testing.T) {
+	scheme := runtime.NewScheme()
+	require.NoError(t, clientgoscheme.AddToScheme(scheme))
+	require.NoError(t, infrav1.AddToScheme(scheme))
+	require.NoError(t, clusterv1.AddToScheme(scheme))
+
+	now := metav1.Now()
+	cluster := &clusterv1.Cluster{
+		ObjectMeta: metav1.ObjectMeta{Name: "test", Namespace: "test-ns", UID: types.UID("1000")},
+	}
+	proxmoxCluster := &infrav1.ProxmoxCluster{
+		ObjectMeta: metav1.ObjectMeta{
+			Name:              "test-cluster",
+			Namespace:         "test-ns",
+			DeletionTimestamp: &now,
+			Finalizers:        []string{infrav1.ClusterFinalizer},
+			OwnerReferences: []metav1.OwnerReference{{
+				APIVersion: clusterv1.GroupVersion.String(),
+				Kind:       "Cluster",
+				Name:       cluster.Name,
+				UID:        cluster.UID,
+			}},
+		},
+	}
+
+	k8s := fake.NewClientBuilder().
+		WithScheme(scheme).
+		WithObjects(cluster, proxmoxCluster).
+		WithStatusSubresource(&infrav1.ProxmoxCluster{}).
+		Build()
+	reconciler := &ProxmoxClusterReconciler{
+		Client:        k8s,
+		Scheme:        scheme,
+		ProxmoxClient: proxmoxtest.NewMockClient(t),
+	}
+
+	result, err := reconciler.Reconcile(t.Context(), ctrl.Request{NamespacedName: client.ObjectKeyFromObject(proxmoxCluster)})
+
+	require.NoError(t, err)
+	require.Equal(t, infrav1.DefaultReconcilerRequeue, result.RequeueAfter)
+
+	var stored infrav1.ProxmoxCluster
+	require.NoError(t, k8s.Get(t.Context(), client.ObjectKeyFromObject(proxmoxCluster), &stored))
+	require.Contains(t, stored.Finalizers, infrav1.ClusterFinalizer, "the finalizer stays until the owning Cluster is deleted")
+}
