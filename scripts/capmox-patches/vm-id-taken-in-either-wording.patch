@@ -269,7 +264,13 @@ func (c *APIClient) CheckID(ctx context.Context, vmid int64) (bool, error) {
 	if err != nil {
 		return false, fmt.Errorf("cannot get cluster")
 	}
-	return cluster.CheckID(ctx, int(vmid))
