+package controller
+
+import (
+	"context"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/apimachinery/pkg/types"
+	clusterv1 "sigs.k8s.io/cluster-api/api/core/v1beta2"
+	"sigs.k8s.io/controller-runtime/pkg/client/fake"
+	"sigs.k8s.io/controller-runtime/pkg/reconcile"
+
+	infrav1 "github.com/ionos-cloud/cluster-api-provider-proxmox/api/v1alpha2"
+)
+
+// A change of a ProxmoxCluster reaches each of its machines with security groups, also one whose VM
+// is still being created, so their IPSets follow it. Machines without groups and those of other
+// clusters are left alone.
+func TestProxmoxClusterToFirewalledMachines(t *testing.T) {
+	scheme := runtime.NewScheme()
+	require.NoError(t, infrav1.AddToScheme(scheme))
+	machine := func(name, cluster, groups string) *infrav1.ProxmoxMachine {
+		m := &infrav1.ProxmoxMachine{ObjectMeta: metav1.ObjectMeta{
+			Name: name, Namespace: "ns", Labels: map[string]string{clusterv1.ClusterNameLabel: cluster},
+		}}
+		if groups != "" {
+			m.Annotations = map[string]string{"kubehenge.dev/firewall-groups": groups}
+		}
+		return m
+	}
+	r := &ProxmoxMachineReconciler{Client: fake.NewClientBuilder().WithScheme(scheme).WithObjects(
+		machine("cp-1", "c", "k8s"),
+		machine("cp-2-provisioning", "c", "k8s,base"),
+		machine("worker-1", "c", ""),
+		machine("other-1", "other", "k8s"),
+	).Build()}
+
+	byLabel := &infrav1.ProxmoxCluster{ObjectMeta: metav1.ObjectMeta{
+		Name: "c-x1", Namespace: "ns", Labels: map[string]string{clusterv1.ClusterNameLabel: "c"},
+	}}
+	want := []reconcile.Request{
+		{NamespacedName: types.NamespacedName{Namespace: "ns", Name: "cp-1"}},
+		{NamespacedName: types.NamespacedName{Namespace: "ns", Name: "cp-2-provisioning"}},
+	}
+	require.ElementsMatch(t, want, r.proxmoxClusterToFirewalledMachines(context.Background(), byLabel))
+
+	byOwner := &infrav1.ProxmoxCluster{ObjectMeta: metav1.ObjectMeta{
+		Name: "c-x1", Namespace: "ns",
+		OwnerReferences: []metav1.OwnerReference{{APIVersion: clusterv1.GroupVersion.String(), Kind: clusterv1.ClusterKind, Name: "c"}},
+	}}
+	require.ElementsMatch(t, want, r.proxmoxClusterToFirewalledMachines(context.Background(), byOwner))
+
+	orphan := &infrav1.ProxmoxCluster{ObjectMeta: metav1.ObjectMeta{Name: "c-x1", Namespace: "ns"}}
+	require.Empty(t, r.proxmoxClusterToFirewalledMachines(context.Background(), orphan))
+
+	otherNamespace := byLabel.DeepCopy()
+	otherNamespace.Namespace = "elsewhere"
+	require.Empty(t, r.proxmoxClusterToFirewalledMachines(context.Background(), otherNamespace))
+}
diff --git a/internal/service/vmservice/firewall.go b/internal/service/vmservice/firewall.go
