 // +kubebuilder:rbac:groups=infrastructure.cluster.x-k8s.io,resources=proxmoxmachines/finalizers,verbs=update
@@ -251,6 +286,11 @@ func (r *ProxmoxMachineReconciler) reconcileNormal(ctx context.Context, machineS
 	})
 	machineScope.Logger.Info("ProxmoxMachine is ready")
 
+	// A failure leaves the machine ready and is retried, as for a VM whose node is offline.
+	if err := vmservice.ReconcileFirewallSources(ctx, machineScope); err != nil {
+		return reconcile.Result{}, errors.Wrap(err, "failed to reconcile the firewall sources")
+	}
+
 	return reconcile.Result{}, nil
 }
 
