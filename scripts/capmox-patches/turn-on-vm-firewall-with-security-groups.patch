+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package vmservice
+
+import (
+	"context"
+	"net/netip"
+	"slices"
+	"strings"
+
+	"github.com/pkg/errors"
+
+	infrav1 "github.com/ionos-cloud/cluster-api-provider-proxmox/api/v1alpha2"
+	"github.com/ionos-cloud/cluster-api-provider-proxmox/pkg/scope"
+)
+
+const (
+	// firewallSourcesAnnotation names, comma-separated, on the ProxmoxCluster, further addresses,
+	// networks in CIDR notation and address ranges that the firewall of each of its machines with
+	// security groups accepts all inbound traffic from. A change reaches the running VMs in place.
+	firewallSourcesAnnotation = "kubehenge.dev/firewall-sources"
+
+	// firewallIPSet is the VM's IPSet of the sources its firewall accepts everything from, ahead of
+	// the security groups.
+	firewallIPSet = "kubehenge"
+)
+
+// firewallSourceRule is the source of the VM's rule that accepts its IPSet. The guest scope keeps a
+// datacenter IPSet of the same name from standing in for it.
+const firewallSourceRule = "+guest/" + firewallIPSet
+
+// ReconcileFirewallSources keeps the IPSet of a VM with security groups at the sources its firewall
+// accepts everything from: the cluster's own traffic and the ProxmoxCluster's further sources. The
+// node address pools and those sources change without replacing the machine, so each reconcile
+// writes them again. Machines without security groups are left alone.
+func ReconcileFirewallSources(ctx context.Context, machineScope *scope.MachineScope) error {
+	if len(firewallGroups(machineScope)) == 0 || machineScope.VirtualMachine == nil {
+		return nil
+	}
+	entries, err := firewallEntries(machineScope)
+	if err != nil {
+		return err
+	}
+	return machineScope.InfraCluster.ProxmoxClient.SyncVMFirewallIPSet(ctx, machineScope.VirtualMachine, firewallIPSet, entries)
+}
+
+// firewallEntries are the IPSet entries of a VM with security groups: the control-plane endpoint,
+// every node address pool and the pod networks, which carry the cluster's own traffic, and the
+// ProxmoxCluster's further sources. They are networks in CIDR notation and single addresses, sorted
+// and each once.
+func firewallEntries(machineScope *scope.MachineScope) ([]string, error) {
+	cluster := machineScope.InfraCluster.ProxmoxCluster
+	var sources []string
+	if _, err := netip.ParseAddr(cluster.Spec.ControlPlaneEndpoint.Host); err == nil {
+		sources = append(sources, cluster.Spec.ControlPlaneEndpoint.Host)
+	}
+	pools := make([]*infrav1.IPConfigSpec, 0, 2+2*len(cluster.Spec.ZoneConfigs))
+	pools = append(pools, cluster.Spec.IPv4Config, cluster.Spec.IPv6Config)
+	for _, zone := range cluster.Spec.ZoneConfigs {
+		pools = append(pools, zone.IPv4Config, zone.IPv6Config)
+	}
+	for _, pool := range pools {
+		if pool != nil {
+			sources = append(sources, pool.Addresses...)
+		}
+	}
+	if machineScope.Cluster != nil {
+		sources = append(sources, machineScope.Cluster.Spec.ClusterNetwork.Pods.CIDRBlocks...)
+	}
+	sources = append(sources, annotationList(cluster.GetAnnotations(), firewallSourcesAnnotation)...)
+
+	entries := make([]string, 0, len(sources))
+	for _, source := range sources {
+		prefixes, err := sourcePrefixes(source)
+		if err != nil {
+			return nil, err
+		}
+		for _, prefix := range prefixes {
+			entries = append(entries, ipSetEntry(prefix))
+		}
+	}
+	slices.Sort(entries)
+	return slices.Compact(entries), nil
+}
+
+// sourcePrefixes turns an address, a network in CIDR notation or an address range such as
+// 10.0.0.10-10.0.0.20 into the fewest networks that cover it, since an IPSet holds no ranges.
+func sourcePrefixes(source string) ([]netip.Prefix, error) {
+	if first, last, isRange := strings.Cut(source, "-"); isRange {
+		from, fromErr := netip.ParseAddr(strings.TrimSpace(first))
+		to, toErr := netip.ParseAddr(strings.TrimSpace(last))
+		if fromErr != nil || toErr != nil || from.BitLen() != to.BitLen() || to.Less(from) {
+			return nil, errors.Errorf("invalid firewall source %q: not an address range", source)
+		}
+		return rangePrefixes(from.WithZone(""), to.WithZone("")), nil
+	}
+	if strings.Contains(source, "/") {
+		prefix, err := netip.ParsePrefix(source)
+		if err != nil {
+			return nil, errors.Wrapf(err, "invalid firewall source %q", source)
+		}
+		return []netip.Prefix{prefix.Masked()}, nil
+	}
+	addr, err := netip.ParseAddr(source)
+	if err != nil {
+		return nil, errors.Wrapf(err, "invalid firewall source %q", source)
+	}
+	addr = addr.WithZone("")
+	return []netip.Prefix{netip.PrefixFrom(addr, addr.BitLen())}, nil
+}
+
+// rangePrefixes splits the range from..to into the fewest networks, from the lowest.
+func rangePrefixes(from, to netip.Addr) []netip.Prefix {
+	var prefixes []netip.Prefix
+	for {
+		bits := from.BitLen()
+		for bits > 0 {
+			wider := netip.PrefixFrom(from, bits-1).Masked()
+			if wider.Addr() != from || lastAddr(wider).Compare(to) > 0 {
+				break
+			}
+			bits--
+		}
+		prefix := netip.PrefixFrom(from, bits)
+		prefixes = append(prefixes, prefix)
+		last := lastAddr(prefix)
+		if last.Compare(to) >= 0 {
+			return prefixes
+		}
+		from = last.Next()
+	}
+}
+
+// lastAddr is the highest address of a network.
+func lastAddr(prefix netip.Prefix) netip.Addr {
+	b := prefix.Addr().AsSlice()
+	for i := prefix.Bits(); i < len(b)*8; i++ {
+		b[i/8] |= 1 << (7 - i%8)
+	}
+	addr, _ := netip.AddrFromSlice(b)
+	return addr
+}
+
+// ipSetEntry writes a network as Proxmox VE keeps an IPSet entry, a single address without its
+// prefix length.
+func ipSetEntry(prefix netip.Prefix) string {
+	if prefix.IsSingleIP() {
+		return prefix.Addr().String()
+	}
+	return prefix.String()
+}
