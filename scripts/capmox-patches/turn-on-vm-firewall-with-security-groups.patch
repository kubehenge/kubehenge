+// firewallSourceComment marks the rules EnableVMFirewall adds for a source it accepts.
+const firewallSourceComment = "kubehenge: the cluster's own traffic"
+
+// EnableVMFirewall turns on a VM's firewall. Its rules accept all inbound traffic from each source
+// (an address, a network in CIDR notation or an address range), then apply each security group,
+// in the order given and ahead of any rule the VM already had. A rule already there is not added
+// again, so a repeated call adds nothing. Proxmox VE filters an interface only when both the VM's
+// firewall and the interface's firewall flag are on.
+func (c *APIClient) EnableVMFirewall(ctx context.Context, vm *proxmox.VirtualMachine, sources, securityGroups []string) error {
+	rules, err := vm.FirewallRules(ctx)
+	if err != nil {
+		return fmt.Errorf("unable to list the firewall rules of vm %d: %w", vm.VMID, err)
+	}
+	present := make(map[string]bool, len(rules))
+	for _, rule := range rules {
+		present[rule.Type+" "+rule.Action+" "+rule.Source] = true
+	}
+	wanted := make([]*proxmox.FirewallRule, 0, len(sources)+len(securityGroups))
+	for _, source := range sources {
+		wanted = append(wanted, &proxmox.FirewallRule{Type: "in", Action: "ACCEPT", Source: source, Enable: 1, Comment: firewallSourceComment})
+	}
+	for _, group := range securityGroups {
+		wanted = append(wanted, &proxmox.FirewallRule{Type: "group", Action: group, Enable: 1})
+	}
+	// Proxmox VE puts a new rule first, so the rules go in from the last one.
+	for i := len(wanted) - 1; i >= 0; i-- {
+		rule := wanted[i]
+		if present[rule.Type+" "+rule.Action+" "+rule.Source] {
+			continue
+		}
+		if err := vm.NewFirewallRule(ctx, rule); err != nil {
+			what := "security group " + rule.Action
+			if rule.Type == "in" {
+				what = "the firewall rule accepting " + rule.Source
+			}
+			return fmt.Errorf("unable to add %s to vm %d: %w", what, vm.VMID, err)
+		}
+	}
+	if err := vm.FirewallOptionSet(ctx, &proxmox.FirewallVirtualMachineOption{Enable: true}); err != nil {
+		return fmt.Errorf("unable to enable the firewall of vm %d: %w", vm.VMID, err)
+	}
+	return nil
+}
+
+// SyncVMFirewallIPSet makes a VM's IPSet hold exactly the entries given, each an address or a network
+// in CIDR notation, and creates the IPSet where the VM lacks it. New entries go in before old ones
+// go, so an address that changes is never left out in between.
+func (c *APIClient) SyncVMFirewallIPSet(ctx context.Context, vm *proxmox.VirtualMachine, name string, entries []string) error {
+	ipSets, err := vm.GetFirewallIPSet(ctx)
+	if err != nil {
+		return fmt.Errorf("unable to list the IPSets of vm %d: %w", vm.VMID, err)
+	}
+	if !slices.ContainsFunc(ipSets, func(ipSet *proxmox.FirewallIPSet) bool { return ipSet.Name == name }) {
+		if err := vm.NewFirewallIPSet(ctx, proxmox.FirewallIPSetCreationOption{Name: name, Comment: firewallSourceComment}); err != nil {
+			return fmt.Errorf("unable to create IPSet %s of vm %d: %w", name, vm.VMID, err)
+		}
+	}
+	present, err := vm.GetFirewallIPSetEntries(ctx, name)
+	if err != nil {
+		return fmt.Errorf("unable to list IPSet %s of vm %d: %w", name, vm.VMID, err)
+	}
+	// Proxmox VE may write an entry otherwise than it was given, so both sides compare as networks.
+	have := make(map[string]string, len(present))
+	for _, entry := range present {
+		have[canonicalIPSetEntry(entry.CIDR)] = entry.CIDR
+	}
+	wanted := make(map[string]bool, len(entries))
+	for _, entry := range entries {
+		key := canonicalIPSetEntry(entry)
+		wanted[key] = true
+		if _, ok := have[key]; ok {
+			continue
+		}
+		if err := vm.NewFirewallIPSetEntry(ctx, name, proxmox.FirewallIPSetEntryCreationOption{CIDR: entry}); err != nil {
+			return fmt.Errorf("unable to add %s to IPSet %s of vm %d: %w", entry, name, vm.VMID, err)
+		}
+	}
+	for _, key := range slices.Sorted(maps.Keys(have)) {
+		if wanted[key] {
+			continue
+		}
+		// The entry is a path segment, and a network's slash would split it.
+		if err := vm.DeleteFirewallIPSetEntry(ctx, name, url.PathEscape(have[key]), ""); err != nil {
+			return fmt.Errorf("unable to remove %s from IPSet %s of vm %d: %w", have[key], name, vm.VMID, err)
+		}
+	}
+	return nil
+}
+
+// canonicalIPSetEntry writes an address or a network in one form, a single address as a full-length
+// network, and leaves anything else as it is.
+func canonicalIPSetEntry(entry string) string {
+	if prefix, err := netip.ParsePrefix(entry); err == nil {
+		return prefix.Masked().String()
+	}
+	if addr, err := netip.ParseAddr(entry); err == nil {
+		return netip.PrefixFrom(addr, addr.BitLen()).String()
+	}
+	return entry
+}
