+func TestProxmoxAPIClient_SyncVMFirewallIPSetFails(t *testing.T) {
+	client := newTestClient(t)
+	vm := &proxmox.VirtualMachine{Node: "test", VMID: 101}
+	vm.New(client.Client, "test", 101)
+
+	// Proxmox VE answers for a node that is offline with status 595 and no body.
+	httpmock.RegisterResponder(http.MethodGet, `=~/nodes/test/qemu/101/firewall/ipset\z`, httpmock.NewStringResponder(595, ""))
+	err := client.SyncVMFirewallIPSet(context.Background(), vm, "kubehenge", []string{"10.0.0.5"})
+	require.ErrorContains(t, err, "unable to list the IPSets of vm 101")
+
+	registerIPSetResponders(t, []map[string]any{{"name": "kubehenge"}}, []map[string]any{{"cidr": "10.0.0.6"}})
+	httpmock.RegisterResponder(http.MethodPost, `=~/nodes/test/qemu/101/firewall/ipset/kubehenge\z`, newJSONResponder(403, nil))
+	err = client.SyncVMFirewallIPSet(context.Background(), vm, "kubehenge", []string{"10.0.0.5"})
+	require.ErrorContains(t, err, "unable to add 10.0.0.5 to IPSet kubehenge of vm 101")
+
+	registerIPSetResponders(t, []map[string]any{{"name": "kubehenge"}}, []map[string]any{{"cidr": "10.0.0.6"}})
+	httpmock.RegisterResponder(http.MethodDelete, `=~/nodes/test/qemu/101/firewall/ipset/kubehenge/`, newJSONResponder(403, nil))
+	err = client.SyncVMFirewallIPSet(context.Background(), vm, "kubehenge", nil)
+	require.ErrorContains(t, err, "unable to remove 10.0.0.6 from IPSet kubehenge of vm 101")
+}
