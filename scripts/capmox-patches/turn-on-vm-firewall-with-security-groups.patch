+		{name: "groups, flag explicitly off", groups: "k8s", net: "virtio=A6:23:64:4D:84:CD,bridge=vmbr0,firewall=0", update: true},
+		{name: "no groups, flag on", net: "virtio=A6:23:64:4D:84:CD,bridge=vmbr0,firewall=1", update: false},
