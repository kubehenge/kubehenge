+
+package vmservice
+
+import (
+	"context"
+	"errors"
+	"net/netip"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	infrav1 "github.com/ionos-cloud/cluster-api-provider-proxmox/api/v1alpha2"
+)
+
+func TestSourcePrefixes(t *testing.T) {
+	tests := []struct {
+		source string
+		want   []string
+	}{
+		{source: "10.0.0.5", want: []string{"10.0.0.5/32"}},
+		{source: "10.244.1.7/16", want: []string{"10.244.0.0/16"}},
+		{source: "10.0.0.10-10.0.0.20", want: []string{"10.0.0.10/31", "10.0.0.12/30", "10.0.0.16/30", "10.0.0.20/32"}},
+		{source: "10.0.0.0-10.0.0.255", want: []string{"10.0.0.0/24"}},
+		{source: "10.0.0.7-10.0.0.7", want: []string{"10.0.0.7/32"}},
+		{source: "0.0.0.0-255.255.255.255", want: []string{"0.0.0.0/0"}},
+		{source: "2001:db8::10-2001:db8::20", want: []string{"2001:db8::10/124", "2001:db8::20/128"}},
+		{source: "2001:db8::/64", want: []string{"2001:db8::/64"}},
+		{source: "2001:db8::5", want: []string{"2001:db8::5/128"}},
+	}
+	for _, test := range tests {
+		prefixes, err := sourcePrefixes(test.source)
+		require.NoError(t, err, test.source)
+		got := make([]string, 0, len(prefixes))
+		for _, p := range prefixes {
+			got = append(got, p.String())
+		}
+		require.Equal(t, test.want, got, test.source)
+	}
+	for _, invalid := range []string{"10.0.0.20-10.0.0.10", "10.0.0.1-2001:db8::1", "10.0.0.1-", "10.0.0.0/33", "node1"} {
+		_, err := sourcePrefixes(invalid)
+		require.Error(t, err, invalid)
+	}
+}
+
+// Every network a range splits into lies inside it, and together they hold each of its addresses once.
+func TestRangePrefixesCoverTheRange(t *testing.T) {
+	from, to := netip.MustParseAddr("192.0.2.3"), netip.MustParseAddr("192.0.2.200")
+	next := from
+	for _, prefix := range rangePrefixes(from, to) {
+		require.Equal(t, next, prefix.Addr())
+		next = lastAddr(prefix).Next()
+	}
+	require.Equal(t, to.Next(), next)
+}
+
+// The IPSet holds the cluster's own traffic, the control-plane endpoint, the node address pools of
+// both families and every zone and the pod networks, and the ProxmoxCluster's further sources, each
+// once.
+func TestFirewallEntries(t *testing.T) {
+	machineScope, _, _ := setupReconcilerTest(t)
+	cluster := machineScope.InfraCluster.ProxmoxCluster
+	cluster.Spec.ControlPlaneEndpoint.Host = "10.0.0.5"
+	cluster.Spec.IPv6Config = &infrav1.IPConfigSpec{Addresses: []string{"2001:db8::10-2001:db8::1f"}, Prefix: 64, Gateway: "2001:db8::1"}
+	cluster.Spec.ZoneConfigs = []infrav1.ZoneConfigSpec{{
+		Zone:       new("zone2"),
+		IPv4Config: &infrav1.IPConfigSpec{Addresses: []string{"10.1.0.0/28"}, Prefix: 24, Gateway: "10.1.0.1"},
+	}}
+	machineScope.Cluster.Spec.ClusterNetwork.Pods.CIDRBlocks = []string{"10.244.0.0/16", "fd5e:4b1c:9a20::/56"}
+	cluster.SetAnnotations(map[string]string{firewallSourcesAnnotation: "192.0.2.11, 2001:db8:1::11,192.0.2.11,"})
+
+	entries, err := firewallEntries(machineScope)
+	require.NoError(t, err)
+	require.Equal(t, []string{
+		"10.0.0.10/31", "10.0.0.12/30", "10.0.0.16/30", "10.0.0.20", "10.0.0.5",
+		"10.1.0.0/28", "10.244.0.0/16", "192.0.2.11",
+		"2001:db8:1::11", "2001:db8::10/124", "fd5e:4b1c:9a20::/56",
+	}, entries)
+
+	cluster.Spec.ControlPlaneEndpoint.Host = "api.example.com"
+	cluster.SetAnnotations(nil)
+	machineScope.Cluster.Spec.ClusterNetwork.Pods.CIDRBlocks = nil
+	cluster.Spec.IPv6Config, cluster.Spec.ZoneConfigs = nil, nil
+	entries, err = firewallEntries(machineScope)
+	require.NoError(t, err)
+	require.Equal(t, []string{"10.0.0.10/31", "10.0.0.12/30", "10.0.0.16/30", "10.0.0.20"}, entries)
+
+	cluster.SetAnnotations(map[string]string{firewallSourcesAnnotation: "management"})
+	_, err = firewallEntries(machineScope)
+	require.ErrorContains(t, err, `invalid firewall source "management"`)
+}
+
+// Only a machine with security groups and a VM has its IPSet written, each time with the cluster's
+// current sources, so an address added, removed or changed on the ProxmoxCluster reaches it.
+func TestReconcileFirewallSources(t *testing.T) {
+	machineScope, proxmoxClient, _ := setupReconcilerTest(t)
+	require.NoError(t, ReconcileFirewallSources(context.Background(), machineScope), "no groups, no VM")
+
+	vm := newRunningVM()
+	machineScope.SetVirtualMachine(vm)
+	require.NoError(t, ReconcileFirewallSources(context.Background(), machineScope), "no groups")
+
+	machineScope.SetAnnotation(firewallGroupsAnnotation, "k8s")
+	cluster := machineScope.InfraCluster.ProxmoxCluster
+	cluster.SetAnnotations(map[string]string{firewallSourcesAnnotation: "192.0.2.11,2001:db8::11"})
+	proxmoxClient.EXPECT().SyncVMFirewallIPSet(context.Background(), vm, "kubehenge",
+		[]string{"10.0.0.10/31", "10.0.0.12/30", "10.0.0.16/30", "10.0.0.20", "192.0.2.11", "2001:db8::11"}).Return(nil).Once()
+	require.NoError(t, ReconcileFirewallSources(context.Background(), machineScope))
+
+	cluster.SetAnnotations(map[string]string{firewallSourcesAnnotation: "192.0.2.12"})
+	cluster.Spec.IPv4Config.Addresses = []string{"10.0.0.10-10.0.0.11"}
+	proxmoxClient.EXPECT().SyncVMFirewallIPSet(context.Background(), vm, "kubehenge",
+		[]string{"10.0.0.10/31", "192.0.2.12"}).Return(nil).Once()
+	require.NoError(t, ReconcileFirewallSources(context.Background(), machineScope))
+
+	proxmoxClient.EXPECT().SyncVMFirewallIPSet(context.Background(), vm, "kubehenge",
+		[]string{"10.0.0.10/31", "192.0.2.12"}).Return(errors.New("595 no route to host")).Once()
+	require.ErrorContains(t, ReconcileFirewallSources(context.Background(), machineScope), "no route to host")
+}
diff --git a/internal/service/vmservice/utils.go b/internal/service/vmservice/utils.go
index 6b9a7fe..28536d6 100644
--- a/internal/service/vmservice/utils.go
+++ b/internal/service/vmservice/utils.go
@@ -40,8 +40,45 @@ const (
 
 	// DefaultNetworkDeviceIPv6 is the default network device name for ipv6.
 	DefaultNetworkDeviceIPv6 = "net0-inet6"
+
+	// firewallGroupsAnnotation names, comma-separated, the Proxmox VE security groups whose rules
+	// police a machine's traffic. With it, the VM's firewall and each interface's firewall flag
+	// are on. Without it, neither is touched.
+	firewallGroupsAnnotation = "kubehenge.dev/firewall-groups"
 )
 
+// annotationList returns the comma-separated entries of an annotation, none when unset.
+func annotationList(annotations map[string]string, annotation string) []string {
+	var entries []string
+	for entry := range strings.SplitSeq(annotations[annotation], ",") {
+		if entry = strings.TrimSpace(entry); entry != "" {
+			entries = append(entries, entry)
+		}
+	}
+	return entries
+}
+
+// firewallGroups returns the security groups of the machine's firewall, none when it has none.
+func firewallGroups(machineScope *scope.MachineScope) []string {
+	return annotationList(machineScope.ProxmoxMachine.GetAnnotations(), firewallGroupsAnnotation)
+}
+
+// HasFirewall reports whether a machine names security groups, which turn its VM's firewall on.
+func HasFirewall(machine *infrav1.ProxmoxMachine) bool {
+	return len(annotationList(machine.GetAnnotations(), firewallGroupsAnnotation)) > 0
+}
+
+// extractNetworkFirewall reports whether a net device input such as
+// virtio=A6:23:64:4D:84:CB,bridge=vmbr1,firewall=1 has its firewall flag on.
+func extractNetworkFirewall(input string) bool {
