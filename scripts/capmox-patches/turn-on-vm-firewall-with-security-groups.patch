+// annotationList returns the comma-separated entries of the machine's annotation, none when unset.
+func annotationList(machineScope *scope.MachineScope, annotation string) []string {
+	var entries []string
+	for entry := range strings.SplitSeq(machineScope.ProxmoxMachine.GetAnnotations()[annotation], ",") {
+		if entry = strings.TrimSpace(entry); entry != "" {
+			entries = append(entries, entry)
+		}
+	}
+	return entries
+}
+
+// firewallGroups returns the security groups of the machine's firewall, none when it has none.
+func firewallGroups(machineScope *scope.MachineScope) []string {
+	return annotationList(machineScope, firewallGroupsAnnotation)
+}
+
+// firewallSources returns the sources the machine's firewall accepts everything from.
+func firewallSources(machineScope *scope.MachineScope) []string {
+	return annotationList(machineScope, firewallSourcesAnnotation)
+}
+
+// extractNetworkFirewall reports whether a net device input such as
+// virtio=A6:23:64:4D:84:CB,bridge=vmbr1,firewall=1 has its firewall flag on.
+func extractNetworkFirewall(input string) bool {
+	for option := range strings.SplitSeq(input, ",") {
+		if option == "firewall=1" {
+			return true
+		}
+	}
+	return false
+}
