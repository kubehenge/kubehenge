+// A VM without the IPSet gets it, with every entry.
+func TestProxmoxAPIClient_SyncVMFirewallIPSetCreates(t *testing.T) {
+	client := newTestClient(t)
+	vm := &proxmox.VirtualMachine{Node: "test", VMID: 101}
+	vm.New(client.Client, "test", 101)
+	calls := registerIPSetResponders(t, []map[string]any{{"name": "other"}}, []map[string]any{})
+
+	require.NoError(t, client.SyncVMFirewallIPSet(context.Background(), vm, "kubehenge", []string{"10.0.0.10/31", "192.0.2.11", "2001:db8::11"}))
+	require.Equal(t, []string{"create kubehenge", "add 10.0.0.10/31", "add 192.0.2.11", "add 2001:db8::11"}, *calls)
+}
+
+// Entries are added before stale ones are removed, on both families. An entry Proxmox VE writes
+// otherwise than it was given is kept, and a network's slash is escaped in the path.
+func TestProxmoxAPIClient_SyncVMFirewallIPSetChanges(t *testing.T) {
+	client := newTestClient(t)
+	vm := &proxmox.VirtualMachine{Node: "test", VMID: 101}
+	vm.New(client.Client, "test", 101)
+	calls := registerIPSetResponders(t, []map[string]any{{"name": "kubehenge"}}, []map[string]any{
+		{"cidr": "10.0.0.5"},
+		{"cidr": "10.0.0.0/30"},
+		{"cidr": "2001:db8::5"},
+		{"cidr": "fd00::/64"},
+	})
+
+	require.NoError(t, client.SyncVMFirewallIPSet(context.Background(), vm, "kubehenge",
+		[]string{"10.0.0.0/29", "10.0.0.5/32", "2001:db8::6", "fd00:0::/64"}))
+	require.Equal(t, []string{
+		"add 10.0.0.0/29",
+		"add 2001:db8::6",
+		"remove 10.0.0.0%2F30",
+		"remove 2001:db8::5",
+	}, *calls)
+
+	calls = registerIPSetResponders(t, []map[string]any{{"name": "kubehenge"}}, []map[string]any{{"cidr": "10.0.0.5"}})
+	require.NoError(t, client.SyncVMFirewallIPSet(context.Background(), vm, "kubehenge", []string{"10.0.0.5"}))
+	require.Empty(t, *calls, "an IPSet already in step is not written")
+
+	calls = registerIPSetResponders(t, []map[string]any{{"name": "kubehenge"}}, []map[string]any{{"cidr": "10.0.0.5"}})
+	require.NoError(t, client.SyncVMFirewallIPSet(context.Background(), vm, "kubehenge", nil))
+	require.Equal(t, []string{"remove 10.0.0.5"}, *calls)
+}
