diff --git a/pkg/proxmox/goproxmox/api_client.go b/pkg/proxmox/goproxmox/api_client.go
index 1391747..7701ad3 100644
--- a/pkg/proxmox/goproxmox/api_client.go
+++ b/pkg/proxmox/goproxmox/api_client.go
@@ -516,6 +516,11 @@ func (c *APIClient) CloudInitStatus(ctx context.Context, vm *proxmox.VirtualMach
 	}
 
 	status, err := vm.WaitForAgentExecExit(ctx, pid, 2)
+	// A busy guest can take longer than the wait. Its status is then unknown, not failed, so the
+	// caller asks again later.
+	if errors.Is(err, proxmox.ErrTimeout) {
+		return true, nil
+	}
 	if err != nil {
 		return false, errors.Wrap(err, "unable to wait for agent exec")
 	}
