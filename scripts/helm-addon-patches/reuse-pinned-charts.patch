+func TestLocateChartReadsPinnedArchiveOnce(t *testing.T) {
+	g := NewWithT(t)
+	r := newHTTPRepository(t, savedChart(t, "1.2.3", ""))
+
+	first, err := r.locate("1.2.3", r.digest)
+	g.Expect(err).NotTo(HaveOccurred())
+	second, err := r.locate("1.2.3", r.digest)
+	g.Expect(err).NotTo(HaveOccurred())
+
+	g.Expect(r.indexRequests.Load()).To(BeEquivalentTo(1))
+	g.Expect(r.chartRequests.Load()).To(BeEquivalentTo(1))
+	g.Expect(first).To(Equal(r.cachePath("1.2.3", r.digest)))
+	g.Expect(second).To(Equal(first))
+	g.Expect(os.ReadFile(second)).To(Equal(r.archive))
+}
+
+func TestLocateChartReplacesCorruptedCache(t *testing.T) {
+	g := NewWithT(t)
+	r := newHTTPRepository(t, savedChart(t, "1.2.3", ""))
+	cached := r.cachePath("1.2.3", r.digest)
+	g.Expect(os.MkdirAll(filepath.Dir(cached), 0o755)).To(Succeed())
+	g.Expect(os.WriteFile(cached, []byte("not the pinned archive"), 0o600)).To(Succeed())
+
+	chartPath, err := r.locate("1.2.3", r.digest)
+	g.Expect(err).NotTo(HaveOccurred())
+
+	g.Expect(r.indexRequests.Load()).To(BeEquivalentTo(1))
+	g.Expect(r.chartRequests.Load()).To(BeEquivalentTo(1))
+	g.Expect(chartPath).To(Equal(cached))
+	g.Expect(os.ReadFile(cached)).To(Equal(r.archive))
+}
