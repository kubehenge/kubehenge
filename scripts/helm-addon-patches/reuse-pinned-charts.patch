+func TestLocateChartCachesNoArchiveOfAnotherDigest(t *testing.T) {
+	g := NewWithT(t)
+	r := newHTTPRepository(t, savedChart(t, "1.2.3", ""))
+	other := "sha256:" + hex.EncodeToString(make([]byte, sha256.Size))
+
+	for range 2 {
+		_, err := r.locate("1.2.3", other)
+		g.Expect(err).To(HaveOccurred())
+	}
+
+	g.Expect(r.indexRequests.Load()).To(BeEquivalentTo(2))
+	g.Expect(r.cachePath("1.2.3", other)).NotTo(BeAnExistingFile())
+}
