+var (
+	sha256Hex = regexp.MustCompile(`^[0-9a-f]{64}$`)
+	// A name or version that matches this cannot take a cached archive's path out of its folder.
+	pinnedChartPart = regexp.MustCompile(`^[A-Za-z0-9._+-]*$`)
+)
+
+// pinnedChartPath is where the archive of a chart pinned to its digest is cached, or "" if it is not cached.
+// Only an HTTP repository's archive is cached. Its digest is the archive's own, so a cached copy can be checked again.
+// An OCI chart's digest is its manifest's, and pulling it reads no repository index.
+// The path holds the chart's name and version too, so that a spec naming another chart by the same digest still fails.
+func pinnedChartPath(cacheDir, repoURL, chartName, version, digest string) string {
+	sum, ok := strings.CutPrefix(digest, "sha256:")
+	if !ok || registry.IsOCI(repoURL) || !sha256Hex.MatchString(sum) ||
+		!pinnedChartPart.MatchString(chartName) || !pinnedChartPart.MatchString(version) {
+		return ""
+	}
+
+	return filepath.Join(cacheDir, "pinned", chartName+"-"+version+"-"+sum+".tgz")
+}
+
+// locateChart locates and verifies a spec's chart. For an HTTP repository Helm downloads and parses the repository's
+// whole index each time, which takes over 100 MiB of heap for a large one. An archive pinned to its digest cannot
+// change, so it is located once and then read from the cache for as long as it still has that digest.
+func locateChart(ctx context.Context, options *helmAction.ChartPathOptions, settings *helmCli.EnvSettings, chartName, repoURL, version, digest string) (string, error) {
+	log := ctrl.LoggerFrom(ctx)
+
+	cached := pinnedChartPath(settings.RepositoryCache, repoURL, chartName, version, digest)
+	if cached != "" {
+		err := verifyChart(cached, repoURL, version, digest)
+		if err == nil {
+			log.V(2).Info("Using cached chart", "path", cached)
+
+			return cached, nil
+		}
+		if !errors.Is(err, os.ErrNotExist) {
+			log.Info("Removing cached chart", "path", cached, "reason", err.Error())
+			if err := os.Remove(cached); err != nil && !errors.Is(err, os.ErrNotExist) {
+				return "", err
+			}
+		}
+	}
+
+	log.V(2).Info("Locating chart...")
+	cp, err := options.LocateChart(chartName, settings)
+	if err != nil {
+		return "", err
+	}
+	if err := verifyChart(cp, repoURL, version, digest); err != nil {
+		return "", err
+	}
+	if cached == "" {
+		return cp, nil
+	}
+	if err := cacheChart(cp, cached); err != nil {
+		// Without the cached copy the next reconcile locates the chart again, as it would without the cache.
+		log.Error(err, "Cannot cache chart", "path", cached)
+
+		return cp, nil
+	}
+
+	return cached, nil
+}
+
+// cacheChart copies a chart archive to path by way of a temporary file, so that a concurrent reconcile of the same
+// chart never reads a half-written archive.
+func cacheChart(chartPath, path string) error {
+	dir := filepath.Dir(path)
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		return err
+	}
+	src, err := os.Open(chartPath)
+	if err != nil {
+		return err
+	}
+	defer func() { _ = src.Close() }()
+	tmp, err := os.CreateTemp(dir, ".partial-*")
+	if err != nil {
+		return err
+	}
+	// Once renamed, the temporary file is gone and this removes nothing.
+	defer func() { _ = os.Remove(tmp.Name()) }()
+	if _, err := io.Copy(tmp, src); err != nil {
+		_ = tmp.Close()
+
+		return err
+	}
+	if err := tmp.Close(); err != nil {
+		return err
+	}
+
+	return os.Rename(tmp.Name(), path)
+}
