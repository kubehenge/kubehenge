+func TestPinnedChartPath(t *testing.T) {
+	t.Parallel()
+
+	const cacheDir, httpRepo, ociRepo = "cache", "https://charts.example.com", "oci://registry.example.com/charts"
+	sum := hex.EncodeToString(make([]byte, sha256.Size))
+
+	testCases := []struct {
+		name      string
+		repoURL   string
+		chartName string
+		version   string
+		digest    string
+		want      string
+	}{
+		{
+			name: "pinned HTTP chart", repoURL: httpRepo, chartName: "nginx", version: "1.2.3+build.1", digest: "sha256:" + sum,
+			want: filepath.Join(cacheDir, "pinned", "nginx-1.2.3+build.1-"+sum+".tgz"),
+		},
+		{name: "no digest", repoURL: httpRepo, chartName: "nginx", version: "1.2.3"},
+		{name: "OCI chart", repoURL: ociRepo, chartName: "nginx", version: "1.2.3", digest: "sha256:" + sum},
+		{name: "other algorithm", repoURL: httpRepo, chartName: "nginx", version: "1.2.3", digest: "sha512:" + sum},
+		{name: "short digest", repoURL: httpRepo, chartName: "nginx", version: "1.2.3", digest: "sha256:abc"},
+		{name: "digest with a path", repoURL: httpRepo, chartName: "nginx", version: "1.2.3", digest: "sha256:../" + sum[3:]},
+		{name: "name with a path", repoURL: httpRepo, chartName: "../nginx", version: "1.2.3", digest: "sha256:" + sum},
+		{name: "version with a path", repoURL: httpRepo, chartName: "nginx", version: "1.2.3/..", digest: "sha256:" + sum},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			NewWithT(t).Expect(pinnedChartPath(cacheDir, tc.repoURL, tc.chartName, tc.version, tc.digest)).To(Equal(tc.want))
+		})
+	}
+}
