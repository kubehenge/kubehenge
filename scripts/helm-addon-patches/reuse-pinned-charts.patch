+// httpRepository serves a chart archive as an HTTP chart repository does and counts the requests for its index
+// and for the archive.
+type httpRepository struct {
+	*httptest.Server
+	archive       []byte
+	digest        string
+	indexRequests atomic.Int32
+	chartRequests atomic.Int32
+	settings      *helmCli.EnvSettings
+}
+
+func newHTTPRepository(t *testing.T, chartPath string) *httpRepository {
+	t.Helper()
+	g := NewWithT(t)
+
+	c, err := helmLoader.Load(chartPath)
+	g.Expect(err).NotTo(HaveOccurred())
+	archive, err := os.ReadFile(chartPath)
+	g.Expect(err).NotTo(HaveOccurred())
+	sum := sha256.Sum256(archive)
+	digest := "sha256:" + hex.EncodeToString(sum[:])
+	archiveName := filepath.Base(chartPath)
+
+	index := repo.NewIndexFile()
+	g.Expect(index.MustAdd(c.Metadata, archiveName, "", digest)).To(Succeed())
+	indexPath := filepath.Join(t.TempDir(), "index.yaml")
+	g.Expect(index.WriteFile(indexPath, 0o600)).To(Succeed())
+	indexData, err := os.ReadFile(indexPath)
+	g.Expect(err).NotTo(HaveOccurred())
+
+	r := &httpRepository{archive: archive, digest: digest}
+	// httptest listens on 127.0.0.1 only.
+	r.Server = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+		switch req.URL.Path {
+		case "/index.yaml":
+			r.indexRequests.Add(1)
+			_, _ = w.Write(indexData)
+		case "/" + archiveName:
+			r.chartRequests.Add(1)
+			_, _ = w.Write(archive)
+		default:
+			http.NotFound(w, req)
+		}
+	}))
+	t.Cleanup(r.Close)
+
+	// Helm writes the index it downloads under its cache home while it reads it.
+	t.Setenv("HELM_CACHE_HOME", t.TempDir())
+	r.settings = helmCli.New()
+	r.settings.RepositoryCache = t.TempDir()
+	r.settings.RepositoryConfig = filepath.Join(t.TempDir(), "repositories.yaml")
+
+	return r
+}
+
+// locate locates the chart nginx as InstallHelmRelease and UpgradeHelmReleaseIfChanged do.
+func (r *httpRepository) locate(version, digest string) (string, error) {
+	install := helmAction.NewInstall(&helmAction.Configuration{})
+	install.RepoURL = r.URL
+	install.Version = locateVersion(r.URL, version, digest)
+
+	return locateChart(context.Background(), &install.ChartPathOptions, r.settings, "nginx", r.URL, version, digest)
+}
+
+func (r *httpRepository) cachePath(version, digest string) string {
+	return pinnedChartPath(r.settings.RepositoryCache, r.URL, "nginx", version, digest)
+}
