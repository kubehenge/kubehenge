+// splitChartDigest splits a version given as version@digest, e.g. 1.2.3@sha256:..., which pins the chart to that digest.
+func splitChartDigest(version string) (string, string) {
+	version, digest, _ := strings.Cut(version, "@")
+
+	return version, digest
+}
+
+// verifyChartArchive checks a chart downloaded from an HTTP repository against its digest, the sha256 of the
+// archive as the repository index lists it. OCI charts are pulled by digest instead, see getHelmChartAndRepoName.
+func verifyChartArchive(chartPath, repoURL, digest string) error {
+	if digest == "" || repoURL == "" {
+		return nil
+	}
+	want, ok := strings.CutPrefix(digest, "sha256:")
+	if !ok {
+		return errors.Errorf("unsupported chart digest %q, expected sha256:<hex>", digest)
+	}
+	f, err := os.Open(chartPath)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+	h := sha256.New()
+	if _, err := io.Copy(h, f); err != nil {
+		return err
+	}
+	if got := hex.EncodeToString(h.Sum(nil)); got != want {
+		return errors.Errorf("chart archive %s has digest sha256:%s, not %s", filepath.Base(chartPath), got, digest)
+	}
+
+	return nil
+}
