+// splitChartDigest splits a version given as version@digest, e.g. 1.2.3@sha256:..., which pins the chart to that digest.
+func splitChartDigest(version string) (string, string) {
+	version, digest, _ := strings.Cut(version, "@")
+
+	return version, digest
+}
+
+// locateVersion is the version Helm locates a chart by. An OCI chart pinned to a digest is pulled by the digest
+// alone: given a version as well, Helm also resolves the version's tag and refuses the chart once a publisher has
+// moved that tag to another digest.
+func locateVersion(repoURL, version, digest string) string {
+	if digest != "" && registry.IsOCI(repoURL) {
+		return ""
+	}
+
+	return version
+}
+
+// verifyChart checks a chart pinned to a digest. An OCI chart, pulled by that digest, must be the pinned version.
+// An archive from an HTTP repository must have the digest, the sha256 of the archive as the repository index lists it.
+func verifyChart(chartPath, repoURL, version, digest string) error {
+	if digest == "" {
+		return nil
+	}
+	if registry.IsOCI(repoURL) {
+		c, err := helmLoader.Load(chartPath)
+		if err != nil {
+			return err
+		}
+		if version != "" && c.Metadata.Version != version {
+			return errors.Errorf("chart %s is version %s, not %s", digest, c.Metadata.Version, version)
+		}
+
+		return nil
+	}
+	want, ok := strings.CutPrefix(digest, "sha256:")
+	if !ok {
+		return errors.Errorf("unsupported chart digest %q, expected sha256:<hex>", digest)
+	}
+	f, err := os.Open(chartPath)
+	if err != nil {
+		return err
+	}
+	defer func() { _ = f.Close() }()
+	h := sha256.New()
+	if _, err := io.Copy(h, f); err != nil {
+		return err
+	}
+	if got := hex.EncodeToString(h.Sum(nil)); got != want {
+		return errors.Errorf("chart archive %s has digest sha256:%s, not %s", filepath.Base(chartPath), got, digest)
+	}
+
+	return nil
+}
