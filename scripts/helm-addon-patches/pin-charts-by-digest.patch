+func TestLocatePinnedOCIChartAfterItsTagMoved(t *testing.T) {
+	t.Parallel()
+	g := NewWithT(t)
+
+	server, digests := ociRegistry(t, savedChart(t, "1.2.3", "pinned: true\n"), savedChart(t, "1.2.3", "pinned: false\n"))
+	registryClient, err := registry.NewClient(registry.ClientOptPlainHTTP())
+	g.Expect(err).NotTo(HaveOccurred())
+	settings := helmCli.New()
+	settings.RepositoryCache = t.TempDir()
+	settings.RepositoryConfig = filepath.Join(t.TempDir(), "repositories.yaml")
+	repoURL := "oci://" + strings.TrimPrefix(server.URL, "http://") + "/charts"
+
+	version, digest := splitChartDigest("1.2.3@" + digests[0])
+	chartName, _, err := getHelmChartAndRepoName("nginx", repoURL, digest)
+	g.Expect(err).NotTo(HaveOccurred())
+	install := helmAction.NewInstall(&helmAction.Configuration{RegistryClient: registryClient})
+
+	install.Version = version
+	_, err = install.LocateChart(chartName, settings)
+	g.Expect(err).To(MatchError(ContainSubstring("chart reference digest mismatch")))
+
+	install.Version = locateVersion(repoURL, version, digest)
+	chartPath, err := install.LocateChart(chartName, settings)
+	g.Expect(err).NotTo(HaveOccurred())
+	g.Expect(verifyChart(chartPath, repoURL, version, digest)).To(Succeed())
+	c, err := helmLoader.Load(chartPath)
+	g.Expect(err).NotTo(HaveOccurred())
+	g.Expect(c.Values).To(HaveKeyWithValue("pinned", true))
+}
