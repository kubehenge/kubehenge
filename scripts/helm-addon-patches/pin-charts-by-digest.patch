+func TestGetHelmChartAndRepoName(t *testing.T) {
+	t.Parallel()
+
+	testCases := []struct {
+		name          string
+		chartName     string
+		repoURL       string
+		digest        string
+		wantChartName string
+		wantRepoURL   string
+	}{
+		{
+			name:          "HTTP repository",
+			chartName:     "nginx",
+			repoURL:       "https://charts.example.com",
+			digest:        "sha256:abc",
+			wantChartName: "nginx",
+			wantRepoURL:   "https://charts.example.com",
+		},
+		{
+			name:          "OCI repository",
+			chartName:     "nginx",
+			repoURL:       "oci://registry.example.com/charts",
+			wantChartName: "oci://registry.example.com/charts/nginx",
+		},
+		{
+			name:          "OCI repository with digest",
+			chartName:     "nginx",
+			repoURL:       "oci://registry.example.com/charts",
+			digest:        "sha256:abc",
+			wantChartName: "oci://registry.example.com/charts/nginx@sha256:abc",
+		},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			g := NewWithT(t)
+			chartName, repoURL, err := getHelmChartAndRepoName(tc.chartName, tc.repoURL, tc.digest)
+			g.Expect(err).NotTo(HaveOccurred())
+			g.Expect(chartName).To(Equal(tc.wantChartName))
+			g.Expect(repoURL).To(Equal(tc.wantRepoURL))
+		})
+	}
+}
+
+func TestSplitChartDigest(t *testing.T) {
+	t.Parallel()
+
+	testCases := []struct {
+		name        string
+		version     string
+		wantVersion string
+		wantDigest  string
+	}{
+		{name: "no version"},
+		{name: "version", version: "1.2.3", wantVersion: "1.2.3"},
+		{name: "version and digest", version: "1.2.3@sha256:abc", wantVersion: "1.2.3", wantDigest: "sha256:abc"},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			g := NewWithT(t)
+			version, digest := splitChartDigest(tc.version)
+			g.Expect(version).To(Equal(tc.wantVersion))
+			g.Expect(digest).To(Equal(tc.wantDigest))
+		})
+	}
+}
+
+func TestVerifyChartArchive(t *testing.T) {
+	t.Parallel()
+
+	chartPath := filepath.Join(t.TempDir(), "nginx-1.2.3.tgz")
+	NewWithT(t).Expect(os.WriteFile(chartPath, []byte("chart"), 0o600)).To(Succeed())
+	sum := sha256.Sum256([]byte("chart"))
+	digest := "sha256:" + hex.EncodeToString(sum[:])
+
+	testCases := []struct {
+		name    string
+		repoURL string
+		digest  string
+		wantErr bool
+	}{
+		{name: "no digest", repoURL: "https://charts.example.com"},
+		{name: "OCI chart, pulled by digest", digest: "sha256:abc"},
+		{name: "matching digest", repoURL: "https://charts.example.com", digest: digest},
+		{name: "other digest", repoURL: "https://charts.example.com", digest: "sha256:abc", wantErr: true},
+		{name: "other algorithm", repoURL: "https://charts.example.com", digest: "sha512:abc", wantErr: true},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			g := NewWithT(t)
+			err := verifyChartArchive(chartPath, tc.repoURL, tc.digest)
+			if tc.wantErr {
+				g.Expect(err).To(HaveOccurred())
+			} else {
+				g.Expect(err).NotTo(HaveOccurred())
+			}
+		})
+	}
+}
