+// ociRegistry serves charts as an OCI registry does, by digest and by tag, and returns each chart's manifest digest.
+// Each chart is tagged with its version, so a later chart of the same version moves the tag from an earlier one.
+func ociRegistry(t *testing.T, charts ...string) (*httptest.Server, []string) {
+	t.Helper()
+	g := NewWithT(t)
+	blobs := map[string][]byte{}
+	manifests := map[string][]byte{}
+	digestOf := func(data []byte) string {
+		sum := sha256.Sum256(data)
+
+		return "sha256:" + hex.EncodeToString(sum[:])
+	}
+	blob := func(mediaType string, data []byte) map[string]any {
+		blobs[digestOf(data)] = data
+
+		return map[string]any{"mediaType": mediaType, "digest": digestOf(data), "size": len(data)}
+	}
+	digests := make([]string, 0, len(charts))
+	for _, chartPath := range charts {
+		c, err := helmLoader.Load(chartPath)
+		g.Expect(err).NotTo(HaveOccurred())
+		archive, err := os.ReadFile(chartPath)
+		g.Expect(err).NotTo(HaveOccurred())
+		config, err := json.Marshal(c.Metadata)
+		g.Expect(err).NotTo(HaveOccurred())
+		manifest, err := json.Marshal(map[string]any{
+			"schemaVersion": 2,
+			"mediaType":     "application/vnd.oci.image.manifest.v1+json",
+			"config":        blob(registry.ConfigMediaType, config),
+			"layers":        []any{blob(registry.ChartLayerMediaType, archive)},
+		})
+		g.Expect(err).NotTo(HaveOccurred())
+		manifests[digestOf(manifest)] = manifest
+		manifests[c.Metadata.Version] = manifest
+		digests = append(digests, digestOf(manifest))
+	}
+
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		var data []byte
+		contentType := "application/octet-stream"
+		if ref, ok := strings.CutPrefix(r.URL.Path, "/v2/charts/nginx/manifests/"); ok {
+			data, contentType = manifests[ref], "application/vnd.oci.image.manifest.v1+json"
+		} else if digest, ok := strings.CutPrefix(r.URL.Path, "/v2/charts/nginx/blobs/"); ok {
+			data = blobs[digest]
+		}
+		if data == nil {
+			http.NotFound(w, r)
+
+			return
+		}
+		w.Header().Set("Content-Type", contentType)
+		w.Header().Set("Docker-Content-Digest", digestOf(data))
+		w.Header().Set("Content-Length", strconv.Itoa(len(data)))
+		if r.Method != http.MethodHead {
+			_, _ = w.Write(data)
+		}
+	}))
+	t.Cleanup(server.Close)
+
+	return server, digests
+}
