+func TestVerifyChart(t *testing.T) {
+	t.Parallel()
+
+	chartPath := savedChart(t, "1.2.3", "")
+	archive, err := os.ReadFile(chartPath)
+	NewWithT(t).Expect(err).NotTo(HaveOccurred())
+	sum := sha256.Sum256(archive)
+	digest := "sha256:" + hex.EncodeToString(sum[:])
+	const httpRepo, ociRepo = "https://charts.example.com", "oci://registry.example.com/charts"
+
+	testCases := []struct {
+		name    string
+		repoURL string
+		version string
+		digest  string
+		wantErr bool
+	}{
+		{name: "no digest", repoURL: httpRepo, version: "1.2.3"},
+		{name: "matching digest", repoURL: httpRepo, version: "1.2.3", digest: digest},
+		{name: "other digest", repoURL: httpRepo, version: "1.2.3", digest: "sha256:abc", wantErr: true},
+		{name: "other algorithm", repoURL: httpRepo, version: "1.2.3", digest: "sha512:abc", wantErr: true},
+		{name: "OCI chart of the version", repoURL: ociRepo, version: "1.2.3", digest: "sha256:abc"},
+		{name: "OCI chart of another version", repoURL: ociRepo, version: "1.2.4", digest: "sha256:abc", wantErr: true},
+		{name: "OCI chart pinned to a digest alone", repoURL: ociRepo, digest: "sha256:abc"},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			g := NewWithT(t)
+			err := verifyChart(chartPath, tc.repoURL, tc.version, tc.digest)
+			if tc.wantErr {
+				g.Expect(err).To(HaveOccurred())
+			} else {
+				g.Expect(err).NotTo(HaveOccurred())
+			}
+		})
+	}
+}
