+// savedChart writes a chart named nginx at the version to a new archive and returns its path.
+func savedChart(t *testing.T, version, values string) string {
+	t.Helper()
+	path, err := chartutil.Save(&chart.Chart{
+		Metadata: &chart.Metadata{APIVersion: chart.APIVersionV2, Name: "nginx", Version: version},
+		Raw:      []*chart.File{{Name: "values.yaml", Data: []byte(values)}},
+	}, t.TempDir())
+	NewWithT(t).Expect(err).NotTo(HaveOccurred())
+
+	return path
+}
