/dist/
# Test binaries from `go test -c` and profiles from `go test -cpuprofile`.
*.test
*.test.exe
*.prof

# The linters' environment, which uv makes from scripts/lint/uv.lock.
/scripts/lint/.venv/

# The frontend's dependencies and build, which `make web` produces; .keep lets Go compile without it.
/web/node_modules/
/web/*.tsbuildinfo
/pkg/ui/dist/*
!/pkg/ui/dist/.keep

# The Gateway API's install file, which `make gateway-api` downloads; .keep lets Go compile without it.
/pkg/provisioner/gatewayapi/*
!/pkg/provisioner/gatewayapi/.keep

# The Cluster API operator's chart archive, which `make capi-operator-chart` downloads.
/management-cluster/charts/cluster-api-operator-*.tgz

# Terraform/OpenTofu working files, state and inputs: state and variables hold credentials.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# Cluster credentials; the source files of that name are code.
kubeconfig*
talosconfig*
!*.go
*.pem
